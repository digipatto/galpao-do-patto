---
import '../styles/tokens.css';

interface Props {
  titulo: string;
  descricao: string;
  secao?: 'achados' | 'blog';
}

const { titulo, descricao, secao } = Astro.props;
const anoAtual = new Date().getFullYear();
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <meta name="theme-color" content="#0b1018" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Clash Display (títulos) e Satoshi (corpo), ambas da Fontshare: uma só
         origem, um só preconnect. Satoshi no lugar da Inter de propósito — a
         Inter está em todo site e não dá personalidade nenhuma à marca. -->
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=clash-display@600,700&f[]=satoshi@400,500,700&display=swap"
    />
  </head>

  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>

    <header class="cabecalho">
      <div class="faixa cabecalho-linha">
        <a class="marca" href="/">
          <img src="/marca/patto.webp" alt="" width="40" height="40" />
          <span>Achados <b>do Patto</b></span>
        </a>

        <nav class="navegacao" aria-label="Seções">
          <a href="/" aria-current={secao === 'achados' ? 'page' : undefined}>Achados</a>
          <a href="/blog" aria-current={secao === 'blog' ? 'page' : undefined}>Blog</a>
        </nav>
      </div>
    </header>

    <main id="conteudo">
      <slot />
    </main>

    <footer class="rodape">
      <div class="faixa">
        <p class="rodape-marca">Achados do Patto</p>
        <p>
          Garimpo no Mercado Livre e publico um achado de cada vez. No Instagram:{' '}
          <a href="https://instagram.com/achadoseofertas.patto" rel="me noopener" target="_blank"
            >@achadoseofertas.patto</a
          >
        </p>
        <p class="miudo">
          Os links de produto são de afiliado: se você comprar por eles, eu ganho
          uma comissão e você não paga nada a mais. Não tenho vínculo com o
          Mercado Livre além do programa de afiliados. Preços e disponibilidade
          mudam sem aviso — quem manda é a página do produto. © {anoAtual}
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .faixa {
    width: min(100% - calc(var(--gutter) * 2), 64rem);
    margin-inline: auto;
  }

  .pular {
    position: absolute;
    left: -9999px;
    top: 0;
    padding: var(--e-3) var(--e-4);
    background: var(--marca);
    color: var(--p-tinta-900);
    font-weight: 600;
    border-radius: 0 0 var(--raio-sm) 0;
    z-index: 20;
  }
  .pular:focus {
    left: 0;
  }

  .cabecalho {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--fundo) 86%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--borda);
  }

  .cabecalho-linha {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-4);
    min-height: 3.5rem;
  }

  .marca {
    display: inline-flex;
    align-items: center;
    gap: var(--e-2);
    font-family: var(--fonte-display);
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: -0.02em;
    color: var(--texto);
    text-decoration: none;
    white-space: nowrap;
  }
  .marca b {
    color: var(--marca);
    font-weight: 600;
  }
  /* O Patto vem de um render com fundo de estúdio. Em vez de fingir recorte
     com máscara redonda — que o piso de qualidade recusa —, o fundo escuro
     dele vira a própria moldura do selo. */
  .marca img {
    width: 2.25rem;
    height: 2.25rem;
    object-fit: cover;
    object-position: 50% 14%;
    border-radius: var(--raio-sm);
    background: var(--p-tinta-800);
  }

  .navegacao {
    display: flex;
    gap: var(--e-1);
  }

  .navegacao a {
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--texto-tenue);
    text-decoration: none;
    transition: color 0.15s, background-color 0.15s;
  }
  .navegacao a:hover {
    color: var(--texto);
    background: var(--superficie);
  }
  .navegacao a[aria-current='page'] {
    color: var(--p-tinta-900);
    background: var(--marca);
    font-weight: 600;
  }

  main {
    min-height: 60svh;
  }

  .rodape {
    margin-top: var(--e-24);
    padding: var(--e-12) 0 var(--e-16);
    border-top: 1px solid var(--borda);
    color: var(--texto-tenue);
    font-size: 0.875rem;
  }

  .rodape p {
    margin: 0 0 var(--e-2);
    max-width: 68ch;
  }

  .rodape-marca {
    font-family: var(--fonte-display);
    font-weight: 600;
    font-size: 1.0625rem;
    color: var(--texto);
    letter-spacing: -0.01em;
  }

  .rodape a {
    color: var(--marca);
  }

  .rodape .miudo {
    margin-top: var(--e-4);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--texto-tenue);
    text-wrap: pretty;
  }
</style>
