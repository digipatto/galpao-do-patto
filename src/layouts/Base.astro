---
import '../styles/tokens.css';
import { SITE } from '../lib/site';

interface Props {
  titulo: string;
  descricao: string;
}

const { titulo, descricao } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imagemSocial = new URL('/og.jpg', Astro.site).href;
const anoAtual = new Date().getFullYear();
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <meta name="theme-color" content="#0a0f17" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Achados & Ofertas" />
    <meta property="og:image" content={imagemSocial} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Achados & Ofertas — eu garimpo, você economiza" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imagemSocial} />

    <!-- Clash Display (títulos) e Satoshi (corpo), as duas da Fontshare: uma
         origem só, um preconnect só. -->
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=clash-display@600,700&f[]=satoshi@400,500,700&display=swap"
    />
  </head>

  <body>
    <main>
      <slot />
    </main>

    <footer class="rodape">
      <div class="coluna">
        <p class="instagram">
          <a href={SITE.instagram} rel="me noopener" target="_blank">{SITE.arroba}</a>
        </p>
        <p class="miudo">
          Os links são de afiliado: se você comprar por eles, posso receber uma
          comissão do Mercado Livre, sem custo a mais pra você. Não tenho
          vínculo com o Mercado Livre além do programa de afiliados. Preço e
          disponibilidade mudam sem aviso: vale o que está na página do
          anúncio. © {anoAtual} {SITE.nome}
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .coluna {
    width: min(100% - calc(var(--gutter) * 2), 34rem);
    margin-inline: auto;
  }

  /* Acima da cena 3D fixa (que fica atrás de tudo) e opaco: o texto do rodapé
     precisa ler sobre fundo liso. */
  .rodape {
    position: relative;
    z-index: 1;
    background: var(--fundo);
    padding: var(--e-12) 0;
    border-top: 1px solid var(--borda);
    font-size: 0.875rem;
    color: var(--texto-tenue);
  }

  .rodape p {
    margin: 0 0 var(--e-3);
    text-align: center;
  }

  /* Único caminho de volta pro Instagram: texto, não botão. O botão da
     página é um só e leva pro Mercado Livre. */
  .rodape a {
    color: var(--texto-suave);
    text-decoration-color: var(--borda-forte);
  }
  .rodape a:hover {
    color: var(--marca);
  }

  .rodape .miudo {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.6;
    text-wrap: pretty;
  }
</style>
