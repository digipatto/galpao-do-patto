---
import Base from '../layouts/Base.astro';
import Oferta from '../components/Oferta.astro';
import OfertaLinha from '../components/OfertaLinha.astro';
import { listarOfertas, VALIDADE_PRECO_DIAS, ehNova } from '../lib/ofertas';

// Dado inválido estoura aqui e o build para, de propósito.
const ofertas = listarOfertas();
const destaque = ofertas[0];

// A placa (h1 + subtítulo) é a bio do Instagram, palavra por palavra: quem clica
// na bio tem que reconhecer a promessa ao chegar.

// O que a esteira precisa de cada oferta. Link de afiliado NÃO vai aqui: o toque
// numa caixa abre /go/<id>.
const paraCena = ofertas.map((o) => ({
  id: o.id,
  href: o.href,
  img: o.img,
  letra: o.titulo.trim().charAt(0).toUpperCase(),
  preco: o.preco.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
  conferidoEm: o.conferidoEm,
  validade: VALIDADE_PRECO_DIAS + 1,
}));

// Ordenação da lista sem JavaScript: cada linha leva a sua posição em cada
// ordem (CSS `order`), e o rádio marcado escolhe qual vale (`:has`).
const posicao = (lista: typeof ofertas) => new Map(lista.map((o, i) => [o.id, i]));
const porRecentes = posicao(ofertas);
const porDesconto = posicao(
  [...ofertas].sort((a, b) => (b.desconto ?? -1) - (a.desconto ?? -1) || b.criadoEm.localeCompare(a.criadoEm)),
);
const porPreco = posicao([...ofertas].sort((a, b) => a.preco - b.preco));
const mostraOrdem = ofertas.length >= 3;
---

<Base
  titulo="Achados & Ofertas — o galpão de ofertas do Patto"
  descricao="Sou o Patto, seu garimpeiro oficial. Achados reais do Mercado Livre, com o link direto de cada um, no meu galpão de ofertas."
>
  <div class="conteudo">
    <!-- A esteira: o poster (imagem) aparece já na primeira pintura; a cena 3D entra
         por cima quando carrega. Sem WebGL ou em aparelho fraco, o poster fica e o
         card do destaque aparece no lugar das caixas tocáveis. -->
    <section class="palco" aria-label="Esteira de achados">
      <canvas id="esteira" aria-hidden="true"></canvas>

      <div class="topo">
        <div class="coluna">
          <header class="placa">
            <div class="avatar">
              <img src="/marca/patto.webp" alt="Patto, o pato de terno" width="56" height="56" />
            </div>
            <div class="placa-texto">
              <h1>Sou o Patto, seu garimpeiro oficial</h1>
              <p class="sub">Achados reais do Mercado Livre</p>
              <p class="aviso">Links de afiliado. Mesmo preço do anúncio.</p>
            </div>
          </header>
        </div>
      </div>

      {
        destaque && (
          <div class="base">
            <div class="coluna">
              <p class="dica">
                Toque numa caixa pra abrir
                <span aria-hidden="true"> · </span>
                <a href="#vitrine">ver em lista</a>
              </p>
              <div class="reserva">
                <Oferta oferta={destaque} prioridade nova={ehNova(destaque)} />
              </div>
            </div>
          </div>
        )
      }
    </section>

    {
      ofertas.length > 0 && (
        <section id="vitrine" class="vitrine" aria-labelledby="vitrine-titulo">
          <div class="coluna">
            <div class="vitrine-topo">
              <h2 id="vitrine-titulo">Todos os achados</h2>
              <p class="conta numeros">{ofertas.length}</p>
            </div>

            {mostraOrdem && (
              <fieldset class="ordem">
                <legend class="sr">Ordenar por</legend>
                <input type="radio" name="ordem" id="ord-recentes" value="recentes" checked />
                <label for="ord-recentes">Recentes</label>
                <input type="radio" name="ordem" id="ord-desconto" value="desconto" />
                <label for="ord-desconto">Desconto</label>
                <input type="radio" name="ordem" id="ord-preco" value="preco" />
                <label for="ord-preco">Menor preço</label>
              </fieldset>
            )}

            <ul class="linhas" role="list">
              {ofertas.map((o) => (
                <OfertaLinha
                  oferta={o}
                  nova={ehNova(o)}
                  ordem={{ recentes: porRecentes.get(o.id)!, desconto: porDesconto.get(o.id)!, preco: porPreco.get(o.id)! }}
                />
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <!-- Barra do "ver tudo": colada no fim da tela enquanto a página rola, e logo
         abaixo da última oferta quando a lista termina. Laranja de propósito: o
         vermelho é só de "comprar este item". -->
    <div class="barra">
      <div class="coluna">
        <a class="ver-todas" href="/go/todas" rel="sponsored nofollow noopener">
          Ver todas as ofertas
          <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"
            ><path d="M4 10h11M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg
          >
        </a>
      </div>
    </div>
  </div>

  <script type="application/json" id="dados-esteira" set:html={JSON.stringify(paraCena)} />
</Base>

<style>
  :global(:root) {
    --barra: 5rem;
  }

  .coluna {
    width: min(100% - calc(var(--gutter) * 2), 34rem);
    margin-inline: auto;
  }

  .conteudo {
    position: relative;
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ---------- palco: a esteira ---------- */

  .palco {
    position: relative;
    height: calc(100svh - var(--barra));
    min-height: 30rem;
    overflow: hidden;
    background: var(--fundo) url('/cena/poster-retrato.webp') center / cover no-repeat;
  }

  @media (min-width: 48rem) and (orientation: landscape) {
    .palco {
      background-image: url('/cena/poster-paisagem.webp');
    }
  }

  .palco canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    /* arrastar de lado empurra a esteira; vertical continua rolando a página */
    touch-action: pan-y;
    opacity: 0;
    transition: opacity 0.5s ease-out;
  }

  .palco canvas[data-pronto] {
    opacity: 1;
  }

  /* A placa e o rodapé do palco não tapam as caixas: o toque passa pro canvas. */
  .topo,
  .base {
    position: absolute;
    left: 0;
    right: 0;
    pointer-events: none;
  }

  .topo {
    top: var(--e-3);
  }

  .base {
    bottom: var(--e-3);
  }

  .base a {
    pointer-events: auto;
  }

  .dica {
    margin: 0;
    white-space: nowrap;
    text-align: center;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--texto-suave);
    text-shadow: 0 1px 8px var(--fundo);
  }

  .dica a {
    color: var(--texto);
    text-underline-offset: 0.2em;
  }

  /* Com a esteira funcionando, o card do destaque sai (as caixas já são o link).
     Sem ela (sem JS, sem WebGL, aparelho fraco), é ele que mostra o produto. */
  .reserva {
    pointer-events: auto;
  }

  :global(html.esteira) .reserva {
    display: none;
  }

  :global(html:not(.esteira)) .dica {
    display: none;
  }

  /* ---------- placa (nome e promessa) ---------- */

  .placa {
    display: flex;
    align-items: center;
    gap: var(--e-3);
    padding: var(--e-2) var(--e-3);
    background: color-mix(in srgb, var(--superficie) 90%, transparent);
    border: 1px solid var(--borda);
    border-radius: var(--raio-sm);
    box-shadow: var(--sombra);
  }

  /* Anel como o do perfil do Instagram: uma cor só, com folga. */
  .avatar {
    flex: 0 0 auto;
    padding: 2px;
    border-radius: 50%;
    background: var(--superficie);
    box-shadow: 0 0 0 2px var(--marca);
  }

  .avatar img {
    display: block;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    object-fit: cover;
  }

  .placa-texto {
    min-width: 0;
  }

  h1 {
    margin: 0;
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: clamp(1.0625rem, 4.8vw, 1.375rem);
    line-height: 1.12;
    letter-spacing: -0.01em;
    word-spacing: 0.1em;
    color: var(--texto);
    text-wrap: balance;
  }

  .sub {
    margin: 0.15rem 0 0;
    font-size: 0.8125rem;
    color: var(--texto-suave);
  }

  .aviso {
    margin: 0.15rem 0 0;
    font-size: 0.6875rem;
    color: var(--texto-tenue);
  }

  /* ---------- vitrine: todos os achados, vários por tela ---------- */

  /* Fundo liso: a lista lê como uma prateleira, não como cards soltos. */
  .vitrine {
    position: relative;
    scroll-margin-top: var(--e-4);
    padding: var(--e-8) 0 var(--e-6);
    background: var(--fundo);
    border-top: 1px solid var(--borda);
  }

  .vitrine-topo {
    display: flex;
    align-items: baseline;
    gap: var(--e-2);
    margin-bottom: var(--e-4);
  }

  h2 {
    margin: 0;
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: 1.375rem;
    line-height: 1.15;
    letter-spacing: -0.01em;
    word-spacing: 0.1em;
  }

  .conta {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--texto-tenue);
  }

  /* Abas de ordem (rádio + :has, sem JavaScript). */
  .ordem {
    /* fieldset não encolhe por padrão (min-content): estourava a largura em 320px */
    min-inline-size: 0;
    display: flex;
    gap: var(--e-1);
    margin: 0 0 var(--e-4);
    padding: 0.2rem;
    border: 1px solid var(--borda);
    border-radius: 999px;
    background: var(--fundo-elevado);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .ordem input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .ordem label {
    flex: 1 0 auto;
    min-height: 2.5rem;
    display: grid;
    place-items: center;
    padding: 0 var(--e-3);
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--texto-suave);
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color 0.15s,
      color 0.15s;
  }

  .ordem label:hover {
    color: var(--texto);
  }

  .ordem input:checked + label {
    background: var(--superficie-alta);
    color: var(--texto);
  }

  .ordem input:focus-visible + label {
    outline: 2px solid var(--marca);
    outline-offset: 2px;
  }

  .linhas {
    display: flex;
    flex-direction: column;
    gap: var(--e-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .linhas :global(.linha) {
    order: var(--o-recentes);
  }
  .vitrine:has(#ord-desconto:checked) .linhas :global(.linha) {
    order: var(--o-desconto);
  }
  .vitrine:has(#ord-preco:checked) .linhas :global(.linha) {
    order: var(--o-preco);
  }

  /* ---------- barra "ver todas" ---------- */

  .barra {
    position: sticky;
    bottom: 0;
    z-index: 10;
    height: var(--barra);
    box-sizing: border-box;
    padding: var(--e-3) 0 max(var(--e-3), env(safe-area-inset-bottom));
    background: var(--fundo);
    /* Sombra com deslocamento: só aparece quando o conteúdo passa por baixo. */
    box-shadow: 0 -14px 20px -14px rgb(0 0 0 / 0.85);
  }

  .ver-todas {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--e-2);
    min-height: 3.25rem;
    padding: 0.8rem 1.5rem;
    border-radius: 999px;
    background: var(--marca);
    color: var(--marca-texto);
    font-size: 1.0625rem;
    font-weight: 700;
    text-decoration: none;
    transition:
      background-color 0.15s,
      transform 0.15s;
  }

  .ver-todas:hover {
    background: var(--marca-clara);
  }

  .ver-todas:active {
    transform: scale(0.99);
  }

  .ver-todas svg {
    width: 1.15em;
    height: 1.15em;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ver-todas:hover svg {
    transform: translateX(3px);
  }

  /* Celular baixo (375×667) e minúsculo (320×568): a placa encolhe pra a esteira
     e os botões continuarem na primeira tela (regra 11). */
  @media (max-height: 700px) {
    .aviso {
      display: none;
    }
    .avatar img {
      width: 2.5rem;
      height: 2.5rem;
    }
  }
</style>

<script>
  // O site só é publicado quando algo muda, então "hoje" no build envelhece.
  // Aqui o navegador corrige com a data de agora (fuso do Brasil):
  //  - preço velho some (data-velho);
  //  - o selo "Novo" sai das ofertas que deixaram de ser novas;
  //  - "em 06/11" vira "hoje" ou "ontem" quando for o caso.
  const hoje = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Sao_Paulo' }).format(new Date());
  const dias = (iso: string) => Math.round((Date.parse(`${hoje}T00:00:00Z`) - Date.parse(`${iso}T00:00:00Z`)) / 86_400_000);
  document.querySelectorAll<HTMLElement>('[data-conferido]').forEach((el) => {
    if (dias(el.dataset.conferido!) >= (Number(el.dataset.validade) || 3)) el.setAttribute('data-velho', '');
  });
  document.querySelectorAll<HTMLElement>('[data-nova]').forEach((el) => {
    if (dias(el.dataset.criado!) > (Number(el.dataset.diasNova) || 3)) el.removeAttribute('data-nova');
  });
  document.querySelectorAll<HTMLElement>('[data-quando]').forEach((el) => {
    const d = dias(el.dataset.quando!);
    if (d === 0) el.textContent = 'hoje';
    else if (d === 1) el.textContent = 'ontem';
  });
</script>

<script>
  // A esteira 3D é um acabamento: carrega depois da primeira pintura, sob
  // demanda. Sem WebGL, com economia de dados ou aparelho fraco, o poster fica,
  // o card do destaque aparece e tudo continua funcionando.
  const tela = document.getElementById('esteira') as HTMLCanvasElement | null;
  const dados = document.getElementById('dados-esteira');
  const nav = navigator as Navigator & { connection?: { saveData?: boolean }; deviceMemory?: number };
  const poupar = !!nav.connection?.saveData || (nav.deviceMemory ?? 8) < 2 || (nav.hardwareConcurrency ?? 8) < 2;

  if (tela && dados && !poupar) {
    const ofertas = JSON.parse(dados.textContent || '[]');
    const iniciar = () =>
      import('../cena/esteira')
        .then(({ montar }) =>
          montar(tela, {
            ofertas,
            palco: tela.parentElement,
            aoAbrir: (o) => location.assign(o.href),
          }),
        )
        .then(() => {
          tela.setAttribute('data-pronto', '');
          document.documentElement.classList.add('esteira');
        })
        .catch(() => {
          /* sem WebGL ou falha ao montar: o poster e o card continuam à vista */
        });
    if ('requestIdleCallback' in window) requestIdleCallback(iniciar, { timeout: 1500 });
    else setTimeout(iniciar, 300);
  }
</script>
