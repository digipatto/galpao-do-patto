---
import Base from '../layouts/Base.astro';
import Oferta from '../components/Oferta.astro';
import { listarOfertas } from '../lib/ofertas';
import { SITE } from '../lib/site';

// Dado inválido estoura aqui e o build para, de propósito.
const ofertas = listarOfertas();
---

<Base
  titulo="Achados & Ofertas — eu garimpo, você economiza"
  descricao="Todas as ofertas que o Patto garimpou no Mercado Livre, num lugar só. Link direto, mesmo preço do anúncio."
>
  <div class="coluna">
    <header class="abertura">
      <div class="avatar">
        <img
          src="/marca/patto.webp"
          alt="Patto, o pato de terno do Achados & Ofertas"
          width="104"
          height="104"
          fetchpriority="high"
        />
      </div>

      <p class="marca">{SITE.nome}</p>

      <h1>Eu garimpo.<br />Você economiza.</h1>
      <p class="sub">Todas as ofertas que garimpei no Mercado Livre, num lugar só.</p>

      <a class="cta" href="/go/todas" rel="sponsored nofollow noopener">
        Ver todas as ofertas
        <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"
          ><path d="M4 10h11M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg
        >
      </a>
      <p class="micro">Abre no Mercado Livre. Link de afiliado, mesmo preço do anúncio.</p>
    </header>

    {
      ofertas.length > 0 && (
        <section class="feed" aria-labelledby="t-feed">
          <h2 id="t-feed">Últimas ofertas</h2>
          <div class="lista">
            {ofertas.map((oferta) => (
              <Oferta oferta={oferta} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</Base>

<style>
  .coluna {
    width: min(100% - calc(var(--gutter) * 2), 34rem);
    margin-inline: auto;
  }

  /* A primeira tela é a página inteira enquanto não há ofertas: identidade,
     uma frase, um botão. Centralizada na vertical pra o botão cair onde o
     polegar está. */
  .abertura {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: min(82svh, 44rem);
    padding: var(--e-12) 0;
    text-align: center;
    /* O único movimento da página: a abertura assenta uma vez. O estado padrão
       (sem animação) já é totalmente visível. */
    animation: assenta 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes assenta {
    from {
      transform: translateY(0.75rem);
      opacity: 0;
    }
  }

  /* Anel como o do perfil do Instagram: uma cor só, com folga. */
  .avatar {
    padding: 4px;
    margin-bottom: var(--e-4);
    border-radius: 50%;
    background: var(--fundo);
    box-shadow: 0 0 0 3px var(--marca);
  }

  .avatar img {
    display: block;
    width: 6.5rem;
    height: 6.5rem;
    border-radius: 50%;
    object-fit: cover;
  }

  .marca {
    margin: 0 0 var(--e-8);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--texto-tenue);
  }

  h1 {
    margin: 0 0 var(--e-4);
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: clamp(2.125rem, 10.6vw, 3.75rem);
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--texto);
  }

  .sub {
    margin: 0 0 var(--e-8);
    max-width: 28ch;
    font-size: 1.125rem;
    line-height: 1.5;
    color: var(--texto-suave);
    text-wrap: balance;
  }

  .cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--e-2);
    width: min(100%, 22rem);
    min-height: 3.5rem;
    padding: 0.9rem 1.5rem;
    border-radius: 999px;
    background: var(--cta);
    color: var(--cta-texto);
    font-size: 1.0625rem;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.15s, transform 0.15s;
  }

  .cta:hover {
    background: var(--cta-hover);
  }

  .cta:active {
    transform: scale(0.99);
  }

  .cta svg {
    width: 1.15em;
    height: 1.15em;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cta:hover svg {
    transform: translateX(3px);
  }

  .micro {
    margin: var(--e-3) 0 0;
    max-width: 30ch;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--texto-tenue);
    text-wrap: balance;
  }

  /* ---------- feed (só existe quando há ofertas) ---------- */

  .feed {
    padding: var(--e-8) 0 0;
  }

  .feed h2 {
    margin: 0 0 var(--e-6);
    text-align: center;
    font-family: var(--fonte-display);
    font-weight: 600;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
    color: var(--texto);
  }

  .lista {
    display: grid;
    gap: var(--e-6);
  }
</style>
