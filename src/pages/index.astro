---
import Base from '../layouts/Base.astro';
import Oferta from '../components/Oferta.astro';
import { listarOfertas } from '../lib/ofertas';

// Dado inválido estoura aqui e o build para, de propósito.
const ofertas = listarOfertas();

// A placa (h1 + subtítulo) é a bio do Instagram, palavra por palavra: quem clica
// na bio tem que reconhecer a promessa ao chegar.
---

<Base
  titulo="Achados & Ofertas — o galpão de ofertas do Patto"
  descricao="Sou o Patto, seu garimpeiro oficial. Achados reais do Mercado Livre, com o link direto de cada um, no meu galpão de ofertas."
>
  <!-- O palco: o poster (imagem) aparece já na primeira pintura; a cena 3D entra
       por cima quando carrega. Sem WebGL, com movimento reduzido ou em aparelho
       fraco, o poster fica e a página funciona igual. -->
  <div class="palco" aria-hidden="true">
    <canvas id="cena"></canvas>
  </div>

  <div class="conteudo">
    <div class="coluna">
      {
        ofertas.length === 0 ? (
          <section class="estacao" data-estacao>
            <header class="placa">
              <div class="avatar">
                <img src="/marca/patto.webp" alt="Patto, o pato de terno" width="56" height="56" />
              </div>
              <div class="placa-texto">
                <h1>Sou o Patto, seu garimpeiro oficial</h1>
                <p class="sub">Achados reais do Mercado Livre</p>
              </div>
            </header>
          </section>
        ) : (
          ofertas.map((oferta, i) => (
            <section class="estacao" data-estacao data-img={oferta.img} data-letra={oferta.titulo.trim().charAt(0).toUpperCase()}>
              {i === 0 && (
                <header class="placa">
                  <div class="avatar">
                    <img src="/marca/patto.webp" alt="Patto, o pato de terno" width="56" height="56" />
                  </div>
                  <div class="placa-texto">
                    <h1>Sou o Patto, seu garimpeiro oficial</h1>
                    <p class="sub">Achados reais do Mercado Livre</p>
                    <p class="aviso">Links de afiliado. Mesmo preço do anúncio.</p>
                  </div>
                </header>
              )}
              <Oferta oferta={oferta} prioridade={i === 0} />
              {i < ofertas.length - 1 && (
                <span class="desce" aria-hidden="true">
                  <svg viewBox="0 0 20 20" focusable="false">
                    <path d="M5 8l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              )}
            </section>
          ))
        )
      }
    </div>

    <!-- Barra do "ver tudo": colada no fim da tela enquanto a página rola, e logo
         abaixo da última oferta quando a lista termina. Laranja de propósito: o
         vermelho é só de "comprar este item". -->
    <div class="barra">
      <div class="coluna">
        <a class="ver-todas" href="/go/todas" rel="sponsored nofollow noopener">
          Ver todas as ofertas
          <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"
            ><path d="M4 10h11M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg
          >
        </a>
      </div>
    </div>
  </div>
</Base>

<style>
  :global(:root) {
    --barra: 5rem;
  }

  .coluna {
    width: min(100% - calc(var(--gutter) * 2), 34rem);
    margin-inline: auto;
  }

  /* ---------- palco (poster + cena 3D) ---------- */

  .palco {
    position: fixed;
    inset: 0;
    z-index: 0;
    /* lvh: a barra do navegador do celular aparecendo/sumindo não redimensiona o
       canvas, então a cena não "pula" ao rolar. */
    height: 100lvh;
    background: var(--fundo) url('/cena/poster-retrato.webp') center / cover no-repeat;
  }

  @media (min-width: 48rem) and (orientation: landscape) {
    .palco {
      background-image: url('/cena/poster-paisagem.webp');
    }
  }

  .palco canvas {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.5s ease-out;
  }

  .palco canvas[data-pronto] {
    opacity: 1;
  }

  .conteudo {
    position: relative;
    z-index: 1;
  }

  /* ---------- estação: uma oferta por tela ---------- */

  .estacao {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--e-3);
    min-height: calc(100svh - var(--barra));
    padding: var(--e-3) 0;
  }

  .desce {
    align-self: center;
    margin-bottom: -0.25rem;
    color: var(--texto-tenue);
    opacity: 0.8;
  }

  .desce svg {
    display: block;
    width: 1.25rem;
    height: 1.25rem;
  }

  /* ---------- placa (nome e promessa) ---------- */

  .placa {
    display: flex;
    align-items: center;
    gap: var(--e-3);
    margin-bottom: auto;
    padding: var(--e-2) var(--e-3);
    background: color-mix(in srgb, var(--superficie) 90%, transparent);
    border: 1px solid var(--borda);
    border-radius: var(--raio-sm);
    box-shadow: var(--sombra);
  }

  /* Anel como o do perfil do Instagram: uma cor só, com folga. */
  .avatar {
    flex: 0 0 auto;
    padding: 2px;
    border-radius: 50%;
    background: var(--superficie);
    box-shadow: 0 0 0 2px var(--marca);
  }

  .avatar img {
    display: block;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    object-fit: cover;
  }

  .placa-texto {
    min-width: 0;
  }

  h1 {
    margin: 0;
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: clamp(1.0625rem, 4.8vw, 1.375rem);
    line-height: 1.12;
    letter-spacing: -0.01em;
    word-spacing: 0.1em;
    color: var(--texto);
    text-wrap: balance;
  }

  .sub {
    margin: 0.15rem 0 0;
    font-size: 0.8125rem;
    color: var(--texto-suave);
  }

  .aviso {
    margin: 0.15rem 0 0;
    font-size: 0.6875rem;
    color: var(--texto-tenue);
  }

  /* ---------- barra "ver todas" ---------- */

  .barra {
    position: sticky;
    bottom: 0;
    z-index: 10;
    height: var(--barra);
    box-sizing: border-box;
    padding: var(--e-3) 0 max(var(--e-3), env(safe-area-inset-bottom));
    background: var(--fundo);
    /* Sombra com deslocamento: só aparece quando a cena passa por baixo. */
    box-shadow: 0 -14px 20px -14px rgb(0 0 0 / 0.85);
  }

  .ver-todas {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--e-2);
    min-height: 3.25rem;
    padding: 0.8rem 1.5rem;
    border-radius: 999px;
    background: var(--marca);
    color: var(--marca-texto);
    font-size: 1.0625rem;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.15s, transform 0.15s;
  }

  .ver-todas:hover {
    background: var(--marca-clara);
  }

  .ver-todas:active {
    transform: scale(0.99);
  }

  .ver-todas svg {
    width: 1.15em;
    height: 1.15em;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ver-todas:hover svg {
    transform: translateX(3px);
  }

  /* Celular baixo (375×667) e minúsculo (320×568): a placa encolhe pra a oferta e
     os botões continuarem na primeira tela (regra 11). */
  @media (max-height: 700px) {
    .aviso {
      display: none;
    }
    .avatar img {
      width: 2.5rem;
      height: 2.5rem;
    }
  }
</style>

<script>
  // A cena 3D é um acabamento: carrega depois da primeira pintura, sob demanda.
  // Sem WebGL, com movimento reduzido, economia de dados ou aparelho fraco, o
  // poster fica e tudo continua funcionando.
  const palco = document.getElementById('cena') as HTMLCanvasElement | null;
  const nav = navigator as Navigator & { connection?: { saveData?: boolean }; deviceMemory?: number };
  const poupar =
    matchMedia('(prefers-reduced-motion: reduce)').matches ||
    !!nav.connection?.saveData ||
    (nav.deviceMemory ?? 8) < 2 ||
    (nav.hardwareConcurrency ?? 8) < 2;

  if (palco && !poupar) {
    const secoes = [...document.querySelectorAll<HTMLElement>('[data-estacao]')];
    const iniciar = () =>
      import('../cena/galpao')
        .then(({ montar }) =>
          montar(palco, {
            estacoes: secoes.map((el) => ({ el, img: el.dataset.img, letra: el.dataset.letra })),
          }),
        )
        .then(() => palco.setAttribute('data-pronto', ''))
        .catch(() => {
          /* sem WebGL ou falha ao montar: o poster continua à vista */
        });
    if ('requestIdleCallback' in window) requestIdleCallback(iniciar, { timeout: 1500 });
    else setTimeout(iniciar, 300);
  }
</script>
