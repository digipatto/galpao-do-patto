---
import Base from '../layouts/Base.astro';
import Oferta from '../components/Oferta.astro';
import OfertaLinha from '../components/OfertaLinha.astro';
import { listarOfertas, DIAS_NOVA, ehNova } from '../lib/ofertas';

// Dado inválido estoura aqui e o build para, de propósito.
const ofertas = listarOfertas();

// A placa (h1 + subtítulo) é a bio do Instagram, palavra por palavra: quem clica
// na bio tem que reconhecer a promessa ao chegar.

// A mais nova é o destaque da primeira tela (sobre a cena 3D). As outras vão pra
// vitrine logo abaixo: várias por tela, como nos feeds de oferta (Pelando,
// Promobit), em vez de uma tela inteira por produto.
const [destaque, ...demais] = ofertas;

// Ordenação sem JavaScript: cada linha leva a sua posição em cada ordem (CSS
// `order`), e o rádio marcado escolhe qual vale (`:has`).
const posicao = (lista: typeof demais) => new Map(lista.map((o, i) => [o.id, i]));
const porRecentes = posicao(demais);
const porDesconto = posicao(
  [...demais].sort((a, b) => (b.desconto ?? -1) - (a.desconto ?? -1) || b.criadoEm.localeCompare(a.criadoEm)),
);
const porPreco = posicao([...demais].sort((a, b) => a.preco - b.preco));
const mostraOrdem = demais.length >= 3;
---

<Base
  titulo="Achados & Ofertas — o galpão de ofertas do Patto"
  descricao="Sou o Patto, seu garimpeiro oficial. Achados reais do Mercado Livre, com o link direto de cada um, no meu galpão de ofertas."
>
  <!-- O palco: o poster (imagem) aparece já na primeira pintura; a cena 3D entra
       por cima quando carrega. Sem WebGL, com movimento reduzido ou em aparelho
       fraco, o poster fica e a página funciona igual. -->
  <div class="palco" aria-hidden="true">
    <canvas id="cena"></canvas>
  </div>

  <div class="conteudo">
    <div class="coluna">
      {
        !destaque ? (
          <section class="estacao" data-estacao>
            <header class="placa">
              <div class="avatar">
                <img src="/marca/patto.webp" alt="Patto, o pato de terno" width="56" height="56" />
              </div>
              <div class="placa-texto">
                <h1>Sou o Patto, seu garimpeiro oficial</h1>
                <p class="sub">Achados reais do Mercado Livre</p>
              </div>
            </header>
          </section>
        ) : (
          <section class="estacao" data-estacao data-img={destaque.img} data-letra={destaque.titulo.trim().charAt(0).toUpperCase()}>
            <header class="placa">
              <div class="avatar">
                <img src="/marca/patto.webp" alt="Patto, o pato de terno" width="56" height="56" />
              </div>
              <div class="placa-texto">
                <h1>Sou o Patto, seu garimpeiro oficial</h1>
                <p class="sub">Achados reais do Mercado Livre</p>
                <p class="aviso">Links de afiliado. Mesmo preço do anúncio.</p>
              </div>
            </header>
            <Oferta oferta={destaque} prioridade nova={ehNova(destaque)} />
            {demais.length > 0 && (
              <a class="desce" href="#vitrine">
                Mais {demais.length} {demais.length === 1 ? 'achado' : 'achados'}
                <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                  <path d="M5 8l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            )}
          </section>
        )
      }
    </div>

    {
      demais.length > 0 && (
        <section id="vitrine" class="vitrine" aria-labelledby="vitrine-titulo">
          <div class="coluna">
            <div class="vitrine-topo">
              <h2 id="vitrine-titulo">Mais achados</h2>
              <p class="conta numeros">{demais.length}</p>
            </div>

            {mostraOrdem && (
              <fieldset class="ordem">
                <legend class="sr">Ordenar por</legend>
                <input type="radio" name="ordem" id="ord-recentes" value="recentes" checked />
                <label for="ord-recentes">Recentes</label>
                <input type="radio" name="ordem" id="ord-desconto" value="desconto" />
                <label for="ord-desconto">Desconto</label>
                <input type="radio" name="ordem" id="ord-preco" value="preco" />
                <label for="ord-preco">Menor preço</label>
              </fieldset>
            )}

            <ul class="linhas" role="list">
              {demais.map((o) => (
                <OfertaLinha
                  oferta={o}
                  nova={ehNova(o)}
                  ordem={{ recentes: porRecentes.get(o.id)!, desconto: porDesconto.get(o.id)!, preco: porPreco.get(o.id)! }}
                />
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <!-- Barra do "ver tudo": colada no fim da tela enquanto a página rola, e logo
         abaixo da última oferta quando a lista termina. Laranja de propósito: o
         vermelho é só de "comprar este item". -->
    <div class="barra">
      <div class="coluna">
        <a class="ver-todas" href="/go/todas" rel="sponsored nofollow noopener">
          Ver todas as ofertas
          <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"
            ><path d="M4 10h11M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg
          >
        </a>
      </div>
    </div>
  </div>
</Base>

<style>
  :global(:root) {
    --barra: 5rem;
  }

  .coluna {
    width: min(100% - calc(var(--gutter) * 2), 34rem);
    margin-inline: auto;
  }

  /* ---------- palco (poster + cena 3D) ---------- */

  .palco {
    position: fixed;
    inset: 0;
    z-index: 0;
    /* lvh: a barra do navegador do celular aparecendo/sumindo não redimensiona o
       canvas, então a cena não "pula" ao rolar. */
    height: 100lvh;
    background: var(--fundo) url('/cena/poster-retrato.webp') center / cover no-repeat;
  }

  @media (min-width: 48rem) and (orientation: landscape) {
    .palco {
      background-image: url('/cena/poster-paisagem.webp');
    }
  }

  .palco canvas {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.5s ease-out;
  }

  .palco canvas[data-pronto] {
    opacity: 1;
  }

  .conteudo {
    position: relative;
    z-index: 1;
  }

  /* ---------- estação: uma oferta por tela ---------- */

  .estacao {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--e-3);
    min-height: calc(100svh - var(--barra));
    padding: var(--e-3) 0;
  }

  /* "Mais N achados": leva à vitrine. Discreto: o botão da tela é o do card. */
  .desce {
    align-self: center;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-bottom: -0.25rem;
    padding: 0.25rem 0.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--texto-suave);
    text-decoration: none;
  }

  .desce:hover {
    color: var(--marca);
  }

  .desce svg {
    display: block;
    width: 1.1rem;
    height: 1.1rem;
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ---------- vitrine: os outros achados, vários por tela ---------- */

  /* Fundo liso por cima da cena: a lista lê como uma prateleira, não como
     cards soltos sobre o 3D. */
  .vitrine {
    position: relative;
    z-index: 1;
    scroll-margin-top: var(--e-4);
    padding: var(--e-8) 0 var(--e-6);
    background: var(--fundo);
    border-top: 1px solid var(--borda);
  }

  .vitrine-topo {
    display: flex;
    align-items: baseline;
    gap: var(--e-2);
    margin-bottom: var(--e-4);
  }

  h2 {
    margin: 0;
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: 1.375rem;
    line-height: 1.15;
    letter-spacing: -0.01em;
    word-spacing: 0.1em;
  }

  .conta {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--texto-tenue);
  }

  /* Abas de ordem (rádio + :has, sem JavaScript). */
  .ordem {
    /* fieldset não encolhe por padrão (min-content): estourava a largura em 320px */
    min-inline-size: 0;
    display: flex;
    gap: var(--e-1);
    margin: 0 0 var(--e-4);
    padding: 0.2rem;
    border: 1px solid var(--borda);
    border-radius: 999px;
    background: var(--fundo-elevado);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .ordem input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .ordem label {
    flex: 1 0 auto;
    min-height: 2.5rem;
    display: grid;
    place-items: center;
    padding: 0 var(--e-3);
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--texto-suave);
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s;
  }

  .ordem label:hover {
    color: var(--texto);
  }

  .ordem input:checked + label {
    background: var(--superficie-alta);
    color: var(--texto);
  }

  .ordem input:focus-visible + label {
    outline: 2px solid var(--marca);
    outline-offset: 2px;
  }

  .linhas {
    display: flex;
    flex-direction: column;
    gap: var(--e-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .linhas :global(.linha) {
    order: var(--o-recentes);
  }
  .vitrine:has(#ord-desconto:checked) .linhas :global(.linha) {
    order: var(--o-desconto);
  }
  .vitrine:has(#ord-preco:checked) .linhas :global(.linha) {
    order: var(--o-preco);
  }

  /* ---------- placa (nome e promessa) ---------- */

  .placa {
    display: flex;
    align-items: center;
    gap: var(--e-3);
    margin-bottom: auto;
    padding: var(--e-2) var(--e-3);
    background: color-mix(in srgb, var(--superficie) 90%, transparent);
    border: 1px solid var(--borda);
    border-radius: var(--raio-sm);
    box-shadow: var(--sombra);
  }

  /* Anel como o do perfil do Instagram: uma cor só, com folga. */
  .avatar {
    flex: 0 0 auto;
    padding: 2px;
    border-radius: 50%;
    background: var(--superficie);
    box-shadow: 0 0 0 2px var(--marca);
  }

  .avatar img {
    display: block;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    object-fit: cover;
  }

  .placa-texto {
    min-width: 0;
  }

  h1 {
    margin: 0;
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: clamp(1.0625rem, 4.8vw, 1.375rem);
    line-height: 1.12;
    letter-spacing: -0.01em;
    word-spacing: 0.1em;
    color: var(--texto);
    text-wrap: balance;
  }

  .sub {
    margin: 0.15rem 0 0;
    font-size: 0.8125rem;
    color: var(--texto-suave);
  }

  .aviso {
    margin: 0.15rem 0 0;
    font-size: 0.6875rem;
    color: var(--texto-tenue);
  }

  /* ---------- barra "ver todas" ---------- */

  .barra {
    position: sticky;
    bottom: 0;
    z-index: 10;
    height: var(--barra);
    box-sizing: border-box;
    padding: var(--e-3) 0 max(var(--e-3), env(safe-area-inset-bottom));
    background: var(--fundo);
    /* Sombra com deslocamento: só aparece quando a cena passa por baixo. */
    box-shadow: 0 -14px 20px -14px rgb(0 0 0 / 0.85);
  }

  .ver-todas {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--e-2);
    min-height: 3.25rem;
    padding: 0.8rem 1.5rem;
    border-radius: 999px;
    background: var(--marca);
    color: var(--marca-texto);
    font-size: 1.0625rem;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.15s, transform 0.15s;
  }

  .ver-todas:hover {
    background: var(--marca-clara);
  }

  .ver-todas:active {
    transform: scale(0.99);
  }

  .ver-todas svg {
    width: 1.15em;
    height: 1.15em;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ver-todas:hover svg {
    transform: translateX(3px);
  }

  /* Celular baixo (375×667) e minúsculo (320×568): a placa encolhe pra a oferta e
     os botões continuarem na primeira tela (regra 11). */
  @media (max-height: 700px) {
    .aviso {
      display: none;
    }
    .avatar img {
      width: 2.5rem;
      height: 2.5rem;
    }
  }
</style>

<script>
  // O site só é publicado quando algo muda, então "hoje" no build envelhece.
  // Aqui o navegador corrige com a data de agora (fuso do Brasil):
  //  - preço velho some (data-velho);
  //  - o selo "Novo" sai das ofertas que deixaram de ser novas;
  //  - "em 06/11" vira "hoje" ou "ontem" quando for o caso.
  const hoje = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Sao_Paulo' }).format(new Date());
  const dias = (iso: string) => Math.round((Date.parse(`${hoje}T00:00:00Z`) - Date.parse(`${iso}T00:00:00Z`)) / 86_400_000);
  document.querySelectorAll<HTMLElement>('[data-conferido]').forEach((el) => {
    if (dias(el.dataset.conferido!) >= (Number(el.dataset.validade) || 3)) el.setAttribute('data-velho', '');
  });
  document.querySelectorAll<HTMLElement>('[data-nova]').forEach((el) => {
    if (dias(el.dataset.criado!) > (Number(el.dataset.diasNova) || 3)) el.removeAttribute('data-nova');
  });
  document.querySelectorAll<HTMLElement>('[data-quando]').forEach((el) => {
    const d = dias(el.dataset.quando!);
    if (d === 0) el.textContent = 'hoje';
    else if (d === 1) el.textContent = 'ontem';
  });
</script>

<script>
  // A cena 3D é um acabamento: carrega depois da primeira pintura, sob demanda.
  // Sem WebGL, com movimento reduzido, economia de dados ou aparelho fraco, o
  // poster fica e tudo continua funcionando.
  const palco = document.getElementById('cena') as HTMLCanvasElement | null;
  const nav = navigator as Navigator & { connection?: { saveData?: boolean }; deviceMemory?: number };
  const poupar =
    matchMedia('(prefers-reduced-motion: reduce)').matches ||
    !!nav.connection?.saveData ||
    (nav.deviceMemory ?? 8) < 2 ||
    (nav.hardwareConcurrency ?? 8) < 2;

  if (palco && !poupar) {
    const secoes = [...document.querySelectorAll<HTMLElement>('[data-estacao]')];
    const iniciar = () =>
      import('../cena/galpao')
        .then(({ montar }) =>
          montar(palco, {
            estacoes: secoes.map((el) => ({ el, img: el.dataset.img, letra: el.dataset.letra })),
          }),
        )
        .then(() => palco.setAttribute('data-pronto', ''))
        .catch(() => {
          /* sem WebGL ou falha ao montar: o poster continua à vista */
        });
    if ('requestIdleCallback' in window) requestIdleCallback(iniciar, { timeout: 1500 });
    else setTimeout(iniciar, 300);
  }
</script>
