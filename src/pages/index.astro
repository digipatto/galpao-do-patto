---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CardProduto from '../components/CardProduto.astro';
import Garimpo from '../components/Garimpo.tsx';
import { listarOfertas, formatarPreco } from '../lib/ofertas';
import { ROTULO_NICHO } from '../lib/schema';

const ofertas = listarOfertas();
const [achado, ...anteriores] = ofertas;

const artigos = (await getCollection('blog', ({ data }) => !data.rascunho)).sort(
  (a, b) => b.data.publicadoEm.getTime() - a.data.publicadoEm.getTime(),
);
const ultimoArtigo = artigos[0];

const dataExtensa = (iso: string) =>
  new Date(`${iso}T12:00:00Z`).toLocaleDateString('pt-BR', {
    day: '2-digit',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });

// Objeção real merece resposta honesta, não contorno. Por isso o FAQ encara
// preço, comissão e garantia de frente.
const perguntas = [
  {
    q: 'Eu pago mais caro comprando pelo seu link?',
    a: 'Não. O preço é exatamente o mesmo do anúncio. A comissão sai da parte do vendedor, não da sua. Se você digitasse o endereço na mão, pagaria igual — só que aí eu não ganharia nada por ter garimpado.',
  },
  {
    q: 'Por que tem só um produto no site?',
    a: 'Porque é esse o trabalho. Publicar cem links é fácil e não vale nada. Eu só subo o que passou nas quatro perguntas do filtro, e isso reprova quase tudo que eu olho. Quando o próximo passar, ele entra aqui.',
  },
  {
    q: 'O preço ainda está valendo?',
    a: 'Eu confiro no dia da publicação e deixo a data escrita na página. Mas preço de Mercado Livre muda sozinho, e quem manda é o anúncio. Clique e confira antes de fechar — se tiver subido, não compre.',
  },
  {
    q: 'A garantia e a troca são com você?',
    a: 'Não. A compra acontece no Mercado Livre, com o vendedor do anúncio. Garantia, nota fiscal, troca e devolução seguem as regras deles e o Código de Defesa do Consumidor. Eu indico; quem vende é a loja.',
  },
  {
    q: 'Como eu sei que o desconto é real?',
    a: 'Porque eu olho quanto o produto custava nos meses anteriores antes de chamar aquilo de oferta. Se o preço cheio apareceu junto com o cartaz de promoção, não entra aqui. É o primeiro filtro e o que mais reprova.',
  },
  {
    q: 'Você tem vínculo com o Mercado Livre?',
    a: 'Só o programa de afiliados, que qualquer pessoa pode entrar. Não sou funcionário, não sou loja oficial e não falo em nome deles. Escolho os produtos sozinho e ninguém me paga pra destacar nada.',
  },
];

const esquemaFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: perguntas.map((p) => ({
    '@type': 'Question',
    name: p.q,
    acceptedAnswer: { '@type': 'Answer', text: p.a },
  })),
};
---

<Base
  titulo="Achados do Patto — um achado por vez, já filtrado"
  descricao="Confiro histórico de preço, reputação do vendedor e avaliações reais antes de publicar. Se o achado está aqui, é porque passou no filtro."
  secao="achados"
  ctaFixo={achado
    ? { href: achado.href, preco: formatarPreco(achado.preco), titulo: achado.titulo }
    : undefined}
>
  <section class="heroi">
    <div class="heroi-fundo">
      <Garimpo client:idle aprovados={Math.max(ofertas.length, 1)} />
    </div>

    <div class="faixa heroi-grade">
      <div class="heroi-texto">
        <h1>O desconto que você viu pode ser mentira.</h1>
        <p class="heroi-sub">
          Na maioria das “promoções” o preço cheio foi inflado na semana
          anterior. Eu confiro o histórico de preço, a reputação do vendedor e
          as avaliações reais antes de publicar qualquer coisa. Um achado de
          cada vez — e esse passou.
        </p>

        {
          achado && (
            <div class="oferta">
              <div class="oferta-mini">
                {achado.img ? (
                  <img src={achado.img} alt="" width="516" height="972" fetchpriority="high" />
                ) : (
                  <span aria-hidden="true">{achado.titulo.charAt(0)}</span>
                )}
              </div>

              <div class="oferta-corpo">
                <p class="oferta-nome">{achado.titulo}</p>
                <p class="oferta-precos">
                  {achado.precoDe !== undefined && (
                    <span class="oferta-de numeros">{formatarPreco(achado.precoDe)}</span>
                  )}
                  <strong class="oferta-por numeros">{formatarPreco(achado.preco)}</strong>
                  {achado.desconto !== undefined && (
                    <span class="selo-desconto numeros">−{achado.desconto}%</span>
                  )}
                </p>
                <a class="botao botao-grande cta" href={achado.href} rel="sponsored nofollow noopener">
                  Pegar no Mercado Livre
                  <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"
                    ><path d="M4 10h11M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg
                  >
                </a>
                <p class="oferta-garantia">
                  Vai direto pro anúncio. Você não paga nada a mais por usar o link.
                </p>
              </div>
            </div>
          )
        }
      </div>

      <div class="heroi-patto">
        <img
          src="/marca/patto.webp"
          alt="O Patto, um pato de terno azul e gravata vermelha"
          width="361"
          height="656"
        />
      </div>
    </div>
  </section>

  {
    achado && (
      <section class="provas" aria-label="O que o anúncio do produto mostra">
        <div class="faixa">
          {/* Faixa de confiança, não painel de métrica: o que vale aqui é a
              frase inteira ser verificável no anúncio, não o número ser grande. */}
          <p class="provas-linha">
            {achado.avaliacao !== undefined && achado.avaliacoes !== undefined && (
              <span class="prova">
                <svg class="estrela" viewBox="0 0 20 20" aria-hidden="true" focusable="false"
                  ><path d="M10 1.6l2.47 5.26 5.53.82-4 4.06.95 5.76L10 14.8l-4.95 2.7.95-5.76-4-4.06 5.53-.82z" fill="currentColor"/></svg
                >
                <span>
                  <strong class="numeros">
                    {achado.avaliacao.toLocaleString('pt-BR', { minimumFractionDigits: 1 })}
                  </strong>{' '}
                  em <span class="numeros">{achado.avaliacoes}</span> avaliações
                </span>
              </span>
            )}
            {achado.ranking && (
              <span class="prova">
                <span>
                  <strong>{achado.ranking.replace(/^(\d+º)\s*/, '$1 ')}</strong>
                </span>
              </span>
            )}
            {achado.vendasVendedor && achado.loja && (
              <span class="prova">
                <span>
                  <strong>{achado.loja}</strong>
                  {achado.lojaOficial ? ', loja oficial, ' : ', '}
                  <span class="numeros">{achado.vendasVendedor}</span> vendas
                </span>
              </span>
            )}
          </p>
          <p class="provas-nota">Dados do próprio anúncio, conferidos na publicação.</p>
        </div>
      </section>
    )
  }

  <section class="problema" aria-labelledby="t-problema">
    <div class="faixa problema-grade">
      <h2 id="t-problema">Comprar bem no Mercado Livre dá trabalho</h2>
      <div class="problema-lista">
        <p>
          <strong>O “de” é inventado.</strong> O vendedor sobe o preço cheio uma
          semana antes pro “por” virar manchete. O desconto existe só no cartaz.
        </p>
        <p>
          <strong>O anúncio não é o vendedor.</strong> O mesmo produto aparece em
          dez lojas, e a diferença entre elas só aparece quando dá problema.
        </p>
        <p>
          <strong>As avaliações enganam.</strong> As de cinco estrelas são
          entusiasmo e as de uma são frete atrasado. O defeito real do produto
          fica escondido no meio.
        </p>
      </div>
    </div>
  </section>

  <section class="filtro" aria-labelledby="t-filtro">
    <div class="faixa">
      <h2 id="t-filtro">Quatro perguntas antes de publicar</h2>
      <p class="filtro-intro">
        É o que eu faço com cada achado antes de ele chegar aqui. A maioria
        reprova logo na primeira.
      </p>

      <ol class="passos">
        <li>
          <h3>Comparo com o histórico</h3>
          <p>
            Vejo quanto o produto custou nos últimos meses. Se o preço de hoje é
            o de sempre, não é oferta — é encenação.
          </p>
        </li>
        <li>
          <h3>Olho o vendedor, não o anúncio</h3>
          <p>
            Reputação, volume de vendas e as perguntas recentes, que é onde
            aparece o que a descrição esconde.
          </p>
        </li>
        <li>
          <h3>Leio as avaliações de três estrelas</h3>
          <p>
            São as únicas honestas: a pessoa gostou do produto e mesmo assim
            achou um problema real.
          </p>
        </li>
        <li>
          <h3>Fecho a conta do preço final</h3>
          <p>
            Com frete, cupom e parcelamento. O mais barato na vitrine nem sempre
            é o mais barato na fatura.
          </p>
        </li>
      </ol>

      {
        ultimoArtigo && (
          <a class="link-forte" href={`/blog/${ultimoArtigo.id}`}>
            Ler o método inteiro no blog
          </a>
        )
      }
    </div>
  </section>

  {
    achado ? (
      <section class="detalhe" aria-labelledby="t-detalhe">
        <div class="faixa detalhe-grade">
          <div class="detalhe-foto">
            <span class="etiqueta">{ROTULO_NICHO[achado.nicho]}</span>
            {achado.img ? (
              <img src={achado.img} alt={achado.titulo} width="516" height="972" loading="lazy" />
            ) : (
              <span class="semfoto" aria-hidden="true">
                {achado.titulo.charAt(0)}
              </span>
            )}
          </div>

          <div class="detalhe-info">
            <h2 id="t-detalhe">{achado.titulo}</h2>

            <div class="detalhe-preco">
              {achado.precoDe !== undefined && (
                <p class="detalhe-de numeros">
                  <span class="sr">Preço cheio:</span>
                  {formatarPreco(achado.precoDe)}
                </p>
              )}
              <p class="detalhe-por numeros">
                {formatarPreco(achado.preco)}
                {achado.desconto !== undefined && (
                  <span class="selo-desconto numeros">−{achado.desconto}%</span>
                )}
              </p>
              {achado.economia !== undefined && (
                <p class="detalhe-economia numeros">
                  Você deixa de gastar {formatarPreco(achado.economia)}
                </p>
              )}
              {achado.parcelas && (
                <p class="detalhe-parcelas numeros">
                  ou {achado.parcelas.vezes}× de {formatarPreco(achado.parcelas.valor)}
                  {achado.parcelas.semJuros ? ' sem juros' : ''}
                </p>
              )}
            </div>

            {achado.especificacoes && achado.especificacoes.length > 0 && (
              <dl class="ficha">
                {achado.especificacoes.map((e) => (
                  <div>
                    <dt>{e.rotulo}</dt>
                    <dd>{e.valor}</dd>
                  </div>
                ))}
              </dl>
            )}

            <ul class="selos">
              {achado.freteGratis && <li>Frete grátis</li>}
              {achado.lojaOficial && <li>Loja oficial</li>}
              {achado.full && <li>Entrega Full</li>}
            </ul>

            <a class="botao botao-grande cta" href={achado.href} rel="sponsored nofollow noopener">
              Pegar no Mercado Livre
              <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"
                ><path d="M4 10h11M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg
              >
            </a>

            {achado.conferidoEm && (
              <p class="detalhe-conferido">
                Preço e anúncio conferidos em {dataExtensa(achado.conferidoEm)}. No
                Mercado Livre o preço muda sozinho — confira antes de fechar.
              </p>
            )}
          </div>
        </div>
      </section>
    ) : (
      <section class="vazio">
        <div class="faixa">
          <p class="vazio-titulo">Nenhum achado publicado ainda.</p>
          <p>
            O primeiro entra como uma linha em <code>src/data/ofertas.json</code>.
          </p>
        </div>
      </section>
    )
  }

  {
    anteriores.length > 0 && (
      <section class="anteriores" aria-labelledby="t-anteriores">
        <div class="faixa">
          <h2 id="t-anteriores">Achados anteriores</h2>
          <div class="grade">
            {anteriores.map((oferta) => (
              <CardProduto oferta={oferta} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="faq" aria-labelledby="t-faq">
    <div class="faixa faq-grade">
      <h2 id="t-faq">Antes de você perguntar</h2>
      <div class="faq-lista">
        {
          perguntas.map((p) => (
            <details>
              <summary>
                {p.q}
                <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"
                  ><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg
                >
              </summary>
              <p>{p.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  {
    achado && (
      <section class="fecho">
        <div class="faixa fecho-caixa">
          <h2>Esse passou no filtro.</h2>
          <p>
            {formatarPreco(achado.preco)}
            {achado.economia !== undefined && (
              <>, {formatarPreco(achado.economia)} abaixo do preço cheio</>
            )}
            . Mesmo preço do anúncio, sem acréscimo por usar o link.
          </p>
          <a class="botao botao-grande cta" href={achado.href} rel="sponsored nofollow noopener">
            Pegar no Mercado Livre
            <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"
              ><path d="M4 10h11M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg
            >
          </a>
          <p class="fecho-risco">
            Compra, garantia e devolução são no Mercado Livre, com o vendedor do
            anúncio. Não gostou do preço lá? Não compre — eu prefiro perder a
            comissão a te vender arrependimento.
          </p>
        </div>
      </section>
    )
  }
  {/* Dado estruturado no fim: não precisa vir antes do conteúdo e, no topo,
      empurrava o primeiro CTA pra metade do documento. */}
  <script type="application/ld+json" set:html={JSON.stringify(esquemaFaq)} is:inline />
</Base>

<style>
  .faixa {
    width: min(100% - calc(var(--gutter) * 2), 64rem);
    margin-inline: auto;
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  h2 {
    margin: 0 0 var(--e-4);
    font-family: var(--fonte-display);
    font-weight: 600;
    font-size: clamp(1.625rem, 5.5vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--texto);
    text-wrap: balance;
  }

  /* ---------- hero ---------- */

  .heroi {
    position: relative;
    isolation: isolate;
    padding: var(--e-12) 0 var(--e-16);
    overflow: hidden;
  }

  .heroi-fundo {
    position: absolute;
    inset: -12% -6% auto -6%;
    height: 128%;
    z-index: -1;
    /* O campo some nas bordas pra não disputar com o texto. */
    mask-image: radial-gradient(ellipse 72% 62% at 62% 42%, #000 38%, transparent 76%);
    opacity: 0.9;
    pointer-events: none;
  }

  .heroi-grade {
    display: grid;
    gap: var(--e-8);
    align-items: center;
  }

  .heroi h1 {
    margin: 0 0 var(--e-4);
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: clamp(2.25rem, 8.5vw, 4.25rem);
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--texto);
    text-wrap: balance;
  }

  .heroi-sub {
    margin: 0 0 var(--e-8);
    max-width: 50ch;
    font-size: clamp(1rem, 3.4vw, 1.125rem);
    line-height: 1.6;
    color: var(--texto-suave);
    text-wrap: pretty;
  }

  .heroi-patto {
    display: none;
  }

  .oferta {
    display: flex;
    gap: var(--e-4);
    align-items: center;
    padding: var(--e-4);
    background: color-mix(in srgb, var(--fundo-elevado) 92%, transparent);
    backdrop-filter: blur(10px);
    border-radius: var(--raio);
    box-shadow: var(--sombra-alta);
  }

  .oferta-mini {
    flex: 0 0 auto;
    width: 4.5rem;
    height: 6rem;
    display: grid;
    place-items: center;
    border-radius: var(--raio-sm);
    background: radial-gradient(
      ellipse at 50% 35%,
      color-mix(in srgb, var(--terno) 30%, var(--superficie)),
      var(--superficie) 75%
    );
  }
  .oferta-mini img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    padding: 0.3rem;
  }

  .oferta-corpo {
    min-width: 0;
    flex: 1;
  }

  .oferta-nome {
    margin: 0 0 0.15rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--texto-suave);
  }

  .oferta-precos {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 var(--e-3);
  }

  .oferta-de {
    font-size: 0.875rem;
    color: var(--texto-tenue);
    text-decoration: line-through;
  }

  .oferta-por {
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: clamp(1.5rem, 5vw, 1.875rem);
    letter-spacing: -0.03em;
    color: var(--texto);
  }

  .oferta-garantia {
    margin: var(--e-2) 0 0;
    font-size: 0.8125rem;
    color: var(--texto-tenue);
  }

  @media (min-width: 60rem) {
    .heroi {
      padding: var(--e-24) 0;
    }
    .heroi-grade {
      grid-template-columns: 1.15fr 0.85fr;
      gap: var(--e-12);
    }
    .heroi-patto {
      display: block;
      justify-self: end;
    }
    .heroi-patto img {
      width: clamp(13rem, 22vw, 18rem);
      height: auto;
      border-radius: var(--raio);
      box-shadow: var(--sombra-alta);
    }
  }

  /* ---------- botão ---------- */

  .botao {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--e-2);
    padding: 0.9rem 1.5rem;
    min-height: 3rem; /* alvo de toque de 48px */
    border-radius: 999px;
    background: var(--cta);
    color: var(--cta-texto);
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 10px 26px -12px color-mix(in srgb, var(--cta) 85%, transparent);
    transition: background-color 0.15s, transform 0.15s;
  }
  .botao:hover {
    background: var(--cta-hover);
    transform: translateY(-1px);
  }
  .botao:active {
    transform: translateY(0);
  }
  .botao svg {
    width: 1.1em;
    height: 1.1em;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .botao:hover svg {
    transform: translateX(3px);
  }
  .botao-grande {
    width: 100%;
  }
  @media (min-width: 30rem) {
    .botao-grande {
      width: auto;
    }
  }

  .selo-desconto {
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: var(--cta);
    color: var(--cta-texto);
    font-family: var(--fonte-corpo);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0;
  }

  /* ---------- prova social ---------- */

  .provas {
    border-block: 1px solid var(--borda);
    background: var(--fundo-elevado);
  }

  .provas-linha {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-3) var(--e-6);
    margin: 0;
    padding: var(--e-6) 0 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--texto-suave);
  }

  .prova {
    display: inline-flex;
    align-items: center;
    gap: var(--e-2);
  }

  .prova strong {
    font-weight: 600;
    color: var(--texto);
  }

  .estrela {
    flex: 0 0 auto;
    width: 1.05rem;
    height: 1.05rem;
    color: var(--marca);
  }

  .provas-nota {
    margin: var(--e-2) 0 0;
    padding-bottom: var(--e-6);
    font-size: 0.8125rem;
    color: var(--texto-tenue);
  }

  /* ---------- problema ---------- */

  .problema {
    padding: var(--e-24) 0 var(--e-16);
  }

  .problema-grade {
    display: grid;
    gap: var(--e-6);
  }

  .problema-lista {
    display: grid;
    gap: var(--e-4);
  }

  .problema-lista p {
    margin: 0;
    max-width: 68ch;
    line-height: 1.65;
    color: var(--texto-suave);
    text-wrap: pretty;
  }

  .problema-lista strong {
    color: var(--texto);
    font-weight: 600;
  }

  @media (min-width: 52rem) {
    .problema-grade {
      grid-template-columns: 0.8fr 1.2fr;
      gap: var(--e-12);
    }
    .problema h2 {
      margin: 0;
    }
  }

  /* ---------- filtro ---------- */

  .filtro {
