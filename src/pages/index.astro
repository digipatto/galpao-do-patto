---
import Base from '../layouts/Base.astro';
import CardProduto from '../components/CardProduto.astro';
import { listarOfertas } from '../lib/ofertas';

// Se o JSON tiver dado inválido, isto estoura aqui e o build para — de
// propósito. Melhor falhar no build que publicar card quebrado.
const ofertas = listarOfertas();
---

<Base
  titulo="O Galpão do Patto — achados do Mercado Livre"
  descricao="Os achados que o Patto garimpou no Mercado Livre. Preço, desconto e o link direto, sem enrolação."
  secao="achados"
>
  <section class="abertura">
    <div class="faixa">
      <h1>Os achados do Patto</h1>
      <p>
        Garimpo no Mercado Livre e deixo aqui o que vale a pena. Toca no card e
        vai direto pro produto.
      </p>
    </div>
  </section>

  <section class="vitrine">
    <div class="faixa">
      {
        ofertas.length === 0 ? (
          <div class="vazia">
            <p class="vazia-titulo">O galpão ainda está vazio.</p>
            <p>
              O primeiro achado entra como uma linha em
              <code>src/data/ofertas.json</code>.
            </p>
          </div>
        ) : (
          <>
            <p class="contagem">
              {ofertas.length} {ofertas.length === 1 ? 'achado' : 'achados'}
            </p>
            <div class="grade">
              {ofertas.map((oferta) => <CardProduto oferta={oferta} />)}
            </div>
          </>
        )
      }
    </div>
  </section>
</Base>

<style>
  .faixa {
    width: min(100% - calc(var(--gutter) * 2), 68rem);
    margin-inline: auto;
  }

  .abertura {
    padding: 2.5rem 0 1.75rem;
  }

  .abertura h1 {
    margin: 0 0 0.6rem;
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: clamp(1.875rem, 7vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--texto);
    text-wrap: balance;
  }

  .abertura p {
    margin: 0;
    max-width: 44ch;
    font-size: clamp(0.9375rem, 3.5vw, 1.0625rem);
    line-height: 1.55;
    color: var(--texto-suave);
    text-wrap: pretty;
  }

  .contagem {
    margin: 0 0 0.875rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--texto-tenue);
  }

  /* Duas colunas no celular: é como o olho varre vitrine. */
  .grade {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr));
    gap: 0.875rem;
  }

  @media (min-width: 48rem) {
    .grade {
      grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
      gap: 1.25rem;
    }
  }

  .vazia {
    padding: 3rem 1.25rem;
    text-align: center;
    border: 1px dashed var(--superficie-borda);
    border-radius: var(--raio);
    color: var(--texto-tenue);
  }

  .vazia p {
    margin: 0 0 0.4rem;
  }

  .vazia-titulo {
    font-family: var(--fonte-display);
    font-weight: 600;
    font-size: 1.125rem;
    color: var(--texto);
  }

  code {
    font-size: 0.875em;
    padding: 0.1em 0.35em;
    border-radius: var(--raio-sm);
    background: var(--superficie);
    color: var(--holo);
  }
</style>
