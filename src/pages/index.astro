---
import '../styles/tokens.css';
import Mundo from '../three/Mundo';

// Parte 1: a ilha 3D entra com client:only="react" — WebGL nunca no SSR.
// HUD, card e Modo Lista são das Partes 3 e 4.
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>O Galpão do Patto</title>
    <meta
      name="description"
      content="O centro de distribuição de achados do Patto. Em construção."
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;700&display=swap"
    />
    <!-- Clash Display (display da marca) — Fontshare. Fallback: Space Grotesk. -->
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=clash-display@600,700&display=swap"
    />
  </head>

  <body>
    <main class="palco">
      <!--
        Fica atrás do <Canvas> e some debaixo dele quando a ilha monta.
        Serve de estado de carregamento e evita tela preta no primeiro frame.
        O fallback de verdade pra quem não tem WebGL é o Modo Lista, na Parte 4.
      -->
      <div class="cortina" aria-hidden="true">
        <p class="marca">O Galpão do Patto</p>
      </div>

      <Mundo client:only="react" />

      <noscript>
        <div class="cortina cortina--aviso">
          <p class="marca">O Galpão do Patto</p>
          <p class="aviso">
            O galpão precisa de JavaScript pra abrir. Em breve haverá um modo
            lista com todas as ofertas.
          </p>
        </div>
      </noscript>
    </main>
  </body>
</html>

<style>
  .palco {
    position: relative;
    width: 100%;
    height: 100svh;
    overflow: hidden;
    background-color: var(--fundo);
  }

  .cortina {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 2rem var(--gutter);
    text-align: center;
    background-color: var(--fundo);
  }

  .cortina--aviso {
    /* Acima do canvas: sem JS a ilha nunca monta, então o aviso tem que aparecer. */
    z-index: 2;
  }

  .marca {
    margin: 0;
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: clamp(1.5rem, 6vw, 2.5rem);
    letter-spacing: -0.02em;
    color: var(--texto);
  }

  .aviso {
    margin: 0;
    max-width: 38ch;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--texto-tenue);
    text-wrap: pretty;
  }
</style>
