---
import Base from '../layouts/Base.astro';
import Oferta from '../components/Oferta.astro';
import HeroGalpao from '../components/hero/HeroGalpao';
import type { Oferta as TipoOferta } from '../lib/ofertas';
import { listarOfertas } from '../lib/ofertas';

// Dado inválido estoura aqui e o build para, de propósito.
const ofertas = listarOfertas();

// Duas caixas por prateleira. Cada prateleira ganha a própria travessa, então a
// estante cresce uma prateleira por vez conforme o dono posta.
const POR_PRATELEIRA = 2;
const prateleiras: TipoOferta[][] = [];
for (let i = 0; i < ofertas.length; i += POR_PRATELEIRA) {
  prateleiras.push(ofertas.slice(i, i + POR_PRATELEIRA));
}
if (prateleiras.length === 0) prateleiras.push([]);
---

<Base
  titulo="Achados & Ofertas — o galpão de ofertas do Patto"
  descricao="Sou o Patto, seu garimpeiro oficial. Achados reais do Mercado Livre, com o link direto de cada um, no meu galpão de ofertas."
>
  <div class="coluna">
    <!-- Hero compacto: a entrada do galpão. O poster (HTML puro) já está aqui na
         primeira pintura; no desktop a cena 3D entra por cima dele. No celular o
         poster fica e nenhum JS é baixado. Altura baixa de propósito: a oferta e
         os botões continuam na primeira tela. -->
    <div class="hero" aria-hidden="true">
      <img
        class="hero-poster"
        src="/hero/poster.webp"
        width="1088"
        height="288"
        alt=""
        fetchpriority="high"
        decoding="async"
      />
      <HeroGalpao client:media="(min-width: 48rem)" />
    </div>

    <!-- A copy é a bio do Instagram, palavra por palavra: quem clica na bio tem
         que reconhecer a promessa ao chegar. -->
    <header class="placa">
      <div class="avatar">
        <img
          src="/marca/patto.webp"
          alt="Patto, o pato de terno"
          width="56"
          height="56"
        />
      </div>
      <div class="placa-texto">
        <h1>Sou o Patto, seu garimpeiro oficial</h1>
        <p class="sub">Achados reais do Mercado Livre</p>
      </div>
    </header>

    <p class="aviso">Links de afiliado. Mesmo preço do anúncio.</p>

    <!-- O galpão: montantes azuis, travessas laranja, uma caixa por oferta. -->
    <section class="estante" aria-label="Ofertas">
      {
        prateleiras.map((par, p) => (
          <div class="prateleira">
            {par.map((oferta, j) => (
              <Oferta oferta={oferta} prioridade={p === 0 && j === 0} ordem={p * POR_PRATELEIRA + j} />
            ))}
            {Array.from({ length: POR_PRATELEIRA - par.length }).map(() => (
              <div class="vaga" aria-hidden="true">
                <svg viewBox="0 0 20 20" focusable="false"
                  ><path d="M10 4v12M4 10h12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg
                >
                <span>Vaga livre</span>
              </div>
            ))}
          </div>
        ))
      }
    </section>

    <!-- Faixas de corredor no piso, convergindo pro fundo do galpão. -->
    <svg class="piso" viewBox="0 0 400 72" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <polygon points="170,0 181,0 92,72 52,72" fill="currentColor"></polygon>
      <polygon points="219,0 230,0 348,72 308,72" fill="currentColor"></polygon>
    </svg>
  </div>

  <!-- Barra do "ver tudo": colada no fim da tela enquanto a estante rola, e logo
       abaixo do piso quando a estante é curta. Laranja de propósito: o vermelho
       é só de "comprar este item". -->
  <div class="barra">
    <div class="coluna">
      <a class="ver-todas" href="/go/todas" rel="sponsored nofollow noopener">
        Ver todas as ofertas
        <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"
          ><path d="M4 10h11M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg
        >
      </a>
    </div>
  </div>
</Base>

<style>
  .coluna {
    width: min(100% - calc(var(--gutter) * 2), 34rem);
    margin-inline: auto;
  }

  /* ---------- hero (entrada do galpão) ---------- */

  .hero {
    position: relative;
    overflow: hidden;
    margin-top: 0.75rem;
    height: clamp(3.5rem, 9svh, 9rem);
    border-radius: var(--raio-sm);
    background: var(--fundo-elevado);
  }

  /* Celular minúsculo (320×568): não sobra nem um pixel. A oferta e os botões
     valem mais que o hero (regra 11), então ele some. */
  @media (max-height: 600px) {
    .hero {
      display: none;
    }
  }

  /* Desktop sobra tela: o hero respira mais, sem empurrar a oferta. */
  @media (min-width: 48rem) {
    .hero {
      height: clamp(5.5rem, 14svh, 10rem);
    }
  }

  .hero-poster,
  .hero :global(.hero-3d),
  .hero :global(.hero-3d canvas) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-poster {
    object-fit: cover;
    object-position: center 45%;
  }

  /* Nunca captura toque: o hero é vitrine, não controle. */
  .hero :global(.hero-3d) {
    pointer-events: none;
  }

  /* ---------- placa de corredor ---------- */

  .placa {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--e-3);
    margin-top: 1rem;
    padding: var(--e-2) var(--e-3);
    z-index: 1;
    background: var(--superficie);
    border-radius: var(--raio-sm);
    box-shadow: var(--sombra);
  }

  /* Os dois cabos que seguram a placa no teto do galpão. */
  .placa::before,
  .placa::after {
    content: '';
    position: absolute;
    bottom: 100%;
    width: 2px;
    height: 1rem;
    background: var(--borda-forte);
  }
  .placa::before {
    left: 18%;
  }
  .placa::after {
    right: 18%;
  }

  /* Anel como o do perfil do Instagram: uma cor só, com folga. */
  .avatar {
    flex: 0 0 auto;
    padding: 2px;
    border-radius: 50%;
    background: var(--superficie);
    box-shadow: 0 0 0 2px var(--marca);
  }

  .avatar img {
    display: block;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    object-fit: cover;
  }

  .placa-texto {
    min-width: 0;
  }

  h1 {
    margin: 0;
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: clamp(1.1875rem, 5.2vw, 1.5rem);
    line-height: 1.12;
    letter-spacing: -0.01em;
    word-spacing: 0.1em;
    color: var(--texto);
    text-wrap: balance;
  }

  .sub {
    margin: 0.2rem 0 0;
    font-size: 0.8125rem;
    color: var(--texto-suave);
  }

  .aviso {
    margin: var(--e-2) 0 0;
    font-size: 0.75rem;
    color: var(--texto-tenue);
  }

  /* ---------- estante ---------- */

  .estante {
    --mont: 0.5rem;
    position: relative;
    margin-top: var(--e-2);
    padding: 0 var(--mont) var(--e-2);
  }

  /* Os dois montantes azuis da estante. */
  .estante::before,
  .estante::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: var(--mont);
    background: linear-gradient(90deg, var(--montante-claro), var(--montante));
  }
  .estante::before {
    left: 0;
  }
  .estante::after {
    right: 0;
  }

  .prateleira {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--e-2);
    align-items: end;
    padding: var(--e-3) var(--e-2) 0;
  }

  /* Celular baixo (375×667): a prateleira cola mais na placa pra o botão vermelho
     não ficar atrás da barra. */
  @media (max-height: 700px) {
    .prateleira {
      padding-top: var(--e-2);
    }
  }

  .prateleira + .prateleira {
    margin-top: var(--e-1);
  }

  /* A travessa laranja onde as caixas apoiam. Ocupa a prateleira de montante a
     montante, com a sombra que ela joga na parede. */
  .prateleira::after {
    content: '';
    grid-column: 1 / -1;
    height: 0.625rem;
    margin-inline: calc(var(--e-2) * -1);
    background: var(--travessa);
    border-top: 1px solid color-mix(in srgb, var(--travessa) 65%, var(--texto));
    box-shadow: 0 0.5rem 0.75rem -0.4rem rgb(0 0 0 / 0.75);
  }

  /* Vaga vazia: o espaço marcado no chão da prateleira, esperando a próxima
     caixa. Não é clicável e não promete nada além de "livre". */
  .vaga {
    align-self: end;
    display: grid;
    place-items: center;
    align-content: center;
    gap: var(--e-1);
    min-height: 7rem;
    margin-right: 0.625rem;
    border: 2px dashed var(--borda-forte);
    background: repeating-linear-gradient(
      -45deg,
      transparent 0 0.5rem,
      color-mix(in srgb, var(--borda-forte) 14%, transparent) 0.5rem 0.625rem
    );
    color: var(--texto-tenue);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .vaga svg {
    width: 1.25rem;
    height: 1.25rem;
    opacity: 0.8;
  }

  /* ---------- piso ---------- */

  .piso {
    display: block;
    width: 100%;
    height: clamp(2.25rem, 8svh, 4.5rem);
    color: var(--faixa-piso);
    opacity: 0.5;
  }

  /* ---------- barra "ver todas" ---------- */

  .barra {
    position: sticky;
    bottom: 0;
    z-index: 10;
    padding: var(--e-3) 0 max(var(--e-3), env(safe-area-inset-bottom));
    background: var(--fundo);
    /* Sombra com deslocamento: só aparece quando a estante rola por baixo. */
    box-shadow: 0 -14px 20px -14px rgb(0 0 0 / 0.85);
  }

  .ver-todas {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--e-2);
    min-height: 3.25rem;
    padding: 0.8rem 1.5rem;
    border-radius: 999px;
    background: var(--marca);
    color: var(--marca-texto);
    font-size: 1.0625rem;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.15s, transform 0.15s;
  }

  .ver-todas:hover {
    background: var(--marca-clara);
  }

  .ver-todas:active {
    transform: scale(0.99);
  }

  .ver-todas svg {
    width: 1.15em;
    height: 1.15em;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ver-todas:hover svg {
    transform: translateX(3px);
  }
</style>
