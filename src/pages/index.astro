---
import Base from '../layouts/Base.astro';
import Oferta from '../components/Oferta.astro';
import { listarOfertas } from '../lib/ofertas';
import { SITE } from '../lib/site';

// Dado inválido estoura aqui e o build para, de propósito.
const ofertas = listarOfertas();
---

<Base
  titulo="Achados & Ofertas — eu garimpo, você economiza"
  descricao="Ofertas do Mercado Livre garimpadas pelo Patto, com o link direto de cada uma. Mesmo preço do anúncio."
>
  <div class="coluna">
    <!-- Cabeçalho de uma linha só. A versão anterior gastava a primeira tela
         inteira com avatar, título e frase, e o produto ficava abaixo da dobra. -->
    <header class="topo">
      <div class="avatar">
        <img
          src="/marca/patto.webp"
          alt="Patto, o pato de terno do Achados & Ofertas"
          width="56"
          height="56"
        />
      </div>
      <div class="topo-texto">
        <p class="marca">{SITE.nome}</p>
        <h1>Eu garimpo. Você economiza.</h1>
      </div>
    </header>

    <p class="aviso">Links de afiliado do Mercado Livre. Mesmo preço do anúncio.</p>

    {
      ofertas.length > 0 ? (
        <section class="feed" aria-label="Ofertas">
          {ofertas.map((oferta, i) => (
            <Oferta oferta={oferta} prioridade={i === 0} />
          ))}
        </section>
      ) : (
        <p class="vazio">As primeiras ofertas estão chegando.</p>
      )
    }
  </div>

  <!-- Barra do "ver tudo": colada no fim da tela enquanto a lista rola, e logo
       abaixo da última oferta quando a lista é curta. Laranja de propósito: o
       vermelho é só de "comprar este item". -->
  <div class="barra">
    <div class="coluna">
      <a class="ver-todas" href="/go/todas" rel="sponsored nofollow noopener">
        Ver todas as ofertas
        <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"
          ><path d="M4 10h11M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg
        >
      </a>
    </div>
  </div>
</Base>

<style>
  .coluna {
    width: min(100% - calc(var(--gutter) * 2), 34rem);
    margin-inline: auto;
  }

  /* ---------- topo ---------- */

  .topo {
    display: flex;
    align-items: center;
    gap: var(--e-3);
    padding: var(--e-6) 0 var(--e-3);
  }

  /* Anel como o do perfil do Instagram: uma cor só, com folga. */
  .avatar {
    flex: 0 0 auto;
    padding: 2px;
    border-radius: 50%;
    background: var(--fundo);
    box-shadow: 0 0 0 2px var(--marca);
  }

  .avatar img {
    display: block;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    object-fit: cover;
  }

  .topo-texto {
    min-width: 0;
  }

  .marca {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--texto-tenue);
  }

  h1 {
    margin: 0;
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: clamp(1.25rem, 5.6vw, 1.625rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--texto);
    text-wrap: balance;
  }

  .aviso {
    margin: 0 0 var(--e-4);
    font-size: 0.75rem;
    color: var(--texto-tenue);
  }

  /* ---------- feed ---------- */

  .feed {
    display: grid;
    gap: var(--e-4);
  }

  .vazio {
    padding: var(--e-8) 0;
    text-align: center;
    color: var(--texto-suave);
  }

  /* ---------- barra "ver todas" ---------- */

  .barra {
    position: sticky;
    bottom: 0;
    z-index: 10;
    margin-top: var(--e-4);
    padding: var(--e-3) 0 max(var(--e-3), env(safe-area-inset-bottom));
    background: var(--fundo);
    /* Sombra com deslocamento: só é visível quando a lista rola por baixo. */
    box-shadow: 0 -14px 20px -14px rgb(0 0 0 / 0.85);
  }

  .ver-todas {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--e-2);
    min-height: 3.25rem;
    padding: 0.8rem 1.5rem;
    border-radius: 999px;
    background: var(--marca);
    color: var(--marca-texto);
    font-size: 1.0625rem;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.15s, transform 0.15s;
  }

  .ver-todas:hover {
    background: var(--marca-clara);
  }

  .ver-todas:active {
    transform: scale(0.99);
  }

  .ver-todas svg {
    width: 1.15em;
    height: 1.15em;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ver-todas:hover svg {
    transform: translateX(3px);
  }
</style>
