---
import '../styles/tokens.css';
import HeroPoster from '../components/hero/HeroPoster';

/**
 * Gerador do poster do hero (1088×288).
 *
 * Não é página de visitante: existe pra ser fotografada e virar
 * public/hero/poster.webp, o que o celular mostra no lugar da cena 3D.
 * Pra regerar: npm run build, servir dist/, abrir /hero-poster com
 * --enable-unsafe-swiftshader e tirar print em 1088×288.
 */
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Poster do hero</title>
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=clash-display@600,700&f[]=satoshi@400,500,700&display=swap"
    />
  </head>
  <body>
    <div class="quadro">
      <HeroPoster client:only="react" />
    </div>
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    overflow: hidden;
  }
  .quadro {
    width: 1088px;
    height: 288px;
  }
</style>
