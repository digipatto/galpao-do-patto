---
import '../styles/tokens.css';

/**
 * Gerador da imagem de compartilhamento (1200×630).
 *
 * Não é página de visitante: existe pra ser fotografada e virar public/og.jpg,
 * a prévia que aparece quando o link é colado no Instagram e no WhatsApp.
 * Reaproveita os tokens, então a prévia nunca sai do visual do site.
 *
 * Pra regerar: npm run build, servir dist/ e tirar print de /og em 1200×630.
 */
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Imagem de compartilhamento</title>
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=clash-display@600,700&f[]=satoshi@400,500,700&display=swap"
    />
  </head>
  <body>
    <div class="cartao">
      <div class="texto">
        <p class="marca">Achados &amp; Ofertas</p>
        <h1>Eu garimpo.<br />Você economiza.</h1>
        <p class="arroba">@achadoseofertas.patto</p>
      </div>
      <div class="avatar">
        <img src="/marca/patto.webp" alt="" width="384" height="384" />
      </div>
    </div>
  </body>
</html>

<style>
  body {
    margin: 0;
    overflow: hidden;
  }

  .cartao {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    width: 1200px;
    height: 630px;
    padding: 0 5rem;
    background:
      radial-gradient(ellipse 60% 90% at 80% 50%, var(--superficie-alta), transparent 70%),
      var(--fundo);
  }

  .marca {
    margin: 0 0 1.5rem;
    font-family: var(--fonte-display);
    font-weight: 600;
    font-size: 2rem;
    letter-spacing: -0.02em;
    color: var(--marca);
  }

  h1 {
    margin: 0 0 2.25rem;
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: 4.75rem;
    line-height: 0.98;
    letter-spacing: -0.035em;
    color: var(--texto);
  }

  .arroba {
    display: inline-block;
    margin: 0;
    padding: 0.5rem 1.25rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--marca) 18%, transparent);
    color: var(--marca);
    font-size: 1.375rem;
    font-weight: 700;
  }

  .avatar {
    flex: 0 0 auto;
    padding: 10px;
    border-radius: 50%;
    background: var(--fundo);
    box-shadow: 0 0 0 7px var(--marca);
  }

  .avatar img {
    display: block;
    width: 330px;
    height: 330px;
    border-radius: 50%;
    object-fit: cover;
  }
</style>
