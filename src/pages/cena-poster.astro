---
import '../styles/tokens.css';

/**
 * Gerador dos posters do galpão (retrato 780×1688 e paisagem 1600×900).
 *
 * Não é página de visitante: existe pra ser fotografada e virar
 * public/cena/poster-retrato.webp e poster-paisagem.webp, o que aparece no
 * lugar da cena 3D enquanto ela carrega, sem WebGL, ou com movimento reduzido.
 *
 * Uso: /cena-poster?w=780&h=1688&foco=0.2   (a caixa mostra o Patto, não um
 * produto, pra o poster nunca ficar velho quando as ofertas mudarem).
 * Pra regerar: npm run build, servir dist/, abrir com --enable-unsafe-swiftshader.
 */
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Poster do galpão</title>
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=clash-display@600,700&f[]=satoshi@400,500,700&display=swap"
    />
  </head>
  <body>
    <canvas id="cena"></canvas>
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    overflow: hidden;
  }
  #cena {
    display: block;
  }
</style>

<script>
  const q = new URLSearchParams(location.search);
  const w = Number(q.get('w')) || 780;
  const h = Number(q.get('h')) || 1688;
  const foco = Number(q.get('foco') ?? 0.2);
  const cv = document.getElementById('cena') as HTMLCanvasElement;
  cv.style.width = `${w}px`;
  cv.style.height = `${h}px`;
  import('../cena/galpao').then(({ montar }) =>
    montar(cv, {
      estacoes: [{ el: null, img: '/marca/patto.webp', letra: 'P' }],
      estatica: true,
      tamanho: { w, h },
      leve: q.get('leve') === '1',
      foco,
    }),
  );
</script>
