---
import type { Oferta } from '../lib/ofertas';
import { formatarPreco, VALIDADE_PRECO_DIAS } from '../lib/ofertas';

interface Props {
  oferta: Oferta;
  /** A primeira oferta está na primeira tela: carrega já, sem lazy. */
  prioridade?: boolean;
}

const { oferta, prioridade = false } = Astro.props;

// "2026-10-24" -> "24/10". Quebra a string em vez de usar Date: new Date() de
// uma data sem horário vira meia-noite UTC e, no fuso do Brasil, cai no dia
// anterior.
const diaMes = (iso: string) => {
  const [, mes, dia] = iso.split('-');
  return `${dia}/${mes}`;
};

const selos = [
  oferta.ranking,
  oferta.full && 'Full',
  oferta.lojaOficial && 'Loja oficial',
  oferta.freteGratis && 'Frete grátis',
].filter(Boolean) as string[];

// Preço conferido há muito tempo não é mostrado: o botão manda ver o preço
// atual no Mercado Livre. O HTML leva as duas versões e `data-velho` escolhe
// (CSS). O build marca `data-velho` se já nasce velho; um script mínimo na
// página marca no navegador se envelhecer depois do build. Assim o preço velho
// some sem precisar de um deploy por dia. Ver VALIDADE_PRECO_DIAS em
// src/lib/ofertas.ts.
const mostraPreco = oferta.precoValido;
---

<!--
  O card é HTML puro por cima da cena 3D: o texto fica nítido, o botão fica no
  toque e o leitor de tela lê tudo. A caixa 3D (com a foto) está na cena.
-->
<article
  class="oferta"
  data-conferido={oferta.conferidoEm}
  data-validade={VALIDADE_PRECO_DIAS + 1}
  data-velho={mostraPreco ? undefined : ''}
>
  <div class="topo">
    {
      oferta.img && (
        <div class="miniatura">
          <img
            src={oferta.img}
            alt=""
            width="64"
            height="64"
            loading={prioridade ? 'eager' : 'lazy'}
            fetchpriority={prioridade ? 'high' : undefined}
            decoding="async"
          />
        </div>
      )
    }

    <div class="info">
      <h2>{oferta.titulo}</h2>

      <p class="precos">
        {oferta.precoDe !== undefined && (
          <span class="de numeros">
            <span class="sr">Preço cheio:</span>
            {formatarPreco(oferta.precoDe)}
          </span>
        )}
        <strong class="por numeros">{formatarPreco(oferta.preco)}</strong>
        {oferta.desconto !== undefined && <span class="desconto numeros">−{oferta.desconto}%</span>}
      </p>
      <p class="sem-preco">O preço muda no Mercado Livre. Veja o de agora.</p>
    </div>
  </div>

  {
    (selos.length > 0 || oferta.avaliacao !== undefined) && (
      <ul class="fatos">
        {oferta.avaliacao !== undefined && (
          <li>
            <svg class="estrela" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
              <path
                d="M10 1.6l2.47 5.26 5.53.82-4 4.06.95 5.76L10 14.8l-4.95 2.7.95-5.76-4-4.06 5.53-.82z"
                fill="currentColor"
              />
            </svg>
            <span class="numeros">
              {oferta.avaliacao.toLocaleString('pt-BR', { minimumFractionDigits: 1 })}
              {oferta.avaliacoes !== undefined && ` (${oferta.avaliacoes})`}
            </span>
          </li>
        )}
        {selos.map((s) => <li class="selo">{s}</li>)}
      </ul>
    )
  }

  <!-- O botão é o único link do card, esticado sobre ele todo: um toque em
       qualquer lugar leva ao anúncio, e o leitor de tela ouve um destino só. -->
  <a class="cta" href={oferta.href} rel="sponsored nofollow noopener">
    <span class="rotulo-com">Pegar oferta</span>
    <span class="rotulo-sem">Ver preço atual</span>
    <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
      <path
        d="M4 10h11M11 5l5 5-5 5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </a>

  {oferta.conferidoEm && <p class="nota">Preço do ML em {diaMes(oferta.conferidoEm)}. Pode mudar.</p>}
</article>

<style>
  .oferta {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--e-2);
    padding: var(--e-3);
    border: 1px solid var(--borda);
    border-radius: var(--raio);
    background: color-mix(in srgb, var(--superficie) 94%, transparent);
    box-shadow: var(--sombra);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .oferta:hover {
    transform: translateY(-2px);
  }

  .oferta:active {
    transform: scale(0.99);
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .topo {
    display: flex;
    align-items: center;
    gap: var(--e-3);
  }

  /* Foto de anúncio tem fundo branco e o produto costuma ser escuro: tom claro
     com multiply, igual à face da caixa na cena. */
  .miniatura {
    flex: 0 0 auto;
    width: 4rem;
    height: 4rem;
    overflow: hidden;
    border-radius: var(--raio-sm);
    background: var(--foto-fundo);
  }

  .miniatura img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 0.25rem;
    mix-blend-mode: multiply;
  }

  .info {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  /* Satoshi, não Clash Display: a Clash é fonte de título grande e em 15px as
     letras se fecham. Nome de produto precisa ler rápido. */
  h2 {
    margin: 0;
    font-family: var(--fonte-corpo);
    font-weight: 700;
    font-size: 0.9375rem;
    line-height: 1.25;
    color: var(--texto);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .precos {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--e-2);
    margin: 0;
  }

  .de {
    font-size: 0.75rem;
    color: var(--texto-tenue);
    text-decoration: line-through;
  }

  .por {
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: 1.375rem;
    line-height: 1.1;
    letter-spacing: -0.015em;
    word-spacing: 0.12em;
    color: var(--texto);
  }

  .desconto {
    align-self: center;
    padding: 0.05rem 0.45rem;
    border-radius: 999px;
    background: var(--cta);
    color: var(--cta-texto);
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1.5;
  }

  .oferta:not([data-velho]) .sem-preco,
  .oferta:not([data-velho]) .rotulo-sem,
  .oferta[data-velho] .precos,
  .oferta[data-velho] .rotulo-com,
  .oferta[data-velho] .nota {
    display: none;
  }

  .sem-preco {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--texto-suave);
  }

  .fatos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-1) var(--e-2);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.6875rem;
    color: var(--texto-suave);
  }

  .fatos li {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
  }

  .fatos .selo {
    padding: 0.05rem 0.45rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--marca) 14%, transparent);
    color: var(--marca);
    font-weight: 600;
  }

  .estrela {
    width: 0.8125rem;
    height: 0.8125rem;
    color: var(--marca);
  }

  .cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--e-2);
    min-height: 2.875rem; /* alvo de toque */
    padding: 0.55rem 1rem;
    white-space: nowrap;
    border-radius: 999px;
    background: var(--cta);
    color: var(--cta-texto);
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.15s;
  }

  /* Estica o link sobre o card inteiro (o ancestral posicionado é .oferta). */
  .cta::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--raio);
  }

  .cta:hover {
    background: var(--cta-hover);
  }

  .cta svg {
    flex: 0 0 auto;
    width: 0.95em;
    height: 0.95em;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .oferta:hover .cta svg {
    transform: translateX(3px);
  }

  .nota {
    margin: -0.25rem 0 0;
    text-align: center;
    font-size: 0.6875rem;
    line-height: 1.4;
    color: var(--texto-tenue);
  }

  /* Celular estreito (320px): menos recheio, o botão continua inteiro. */
  @media (max-width: 22.5rem) {
    .oferta {
      padding: var(--e-2) var(--e-3);
      gap: 0.375rem;
    }
    .miniatura {
      width: 3.25rem;
      height: 3.25rem;
    }
    .fatos {
      display: none;
    }
  }
</style>
