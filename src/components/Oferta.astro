---
import type { Oferta } from '../lib/ofertas';
import { formatarPreco } from '../lib/ofertas';

interface Props {
  oferta: Oferta;
  /** A primeira oferta está na primeira tela: carrega já, sem lazy. */
  prioridade?: boolean;
  /** Posição na página, só pra escalonar a entrada das caixas. */
  ordem?: number;
}

const { oferta, prioridade = false, ordem = 0 } = Astro.props;

// "2026-10-24" -> "24/10". Quebra a string em vez de usar Date: new Date() de
// uma data sem horário vira meia-noite UTC e, no fuso do Brasil, cai no dia
// anterior.
const diaMes = (iso: string) => {
  const [, mes, dia] = iso.split('-');
  return `${dia}/${mes}`;
};

const inicial = oferta.titulo.trim().charAt(0).toUpperCase();

const selos = [
  oferta.ranking,
  oferta.full && 'Full',
  oferta.lojaOficial && 'Loja oficial',
  oferta.freteGratis && 'Frete grátis',
].filter(Boolean) as string[];
---

<!--
  Uma oferta é uma CAIXA na prateleira, em projeção oblíqua: a frente é plana
  (o texto nunca é distorcido por rotação 3D) e o topo e a lateral são faces
  inclinadas por skew. É o que dá profundidade sem custar legibilidade nem JS.
-->
<article class="caixa" style={`--i: ${ordem}`}>
  <div class="frente">
    <div class="foto">
      {
        oferta.img ? (
          <img
            src={oferta.img}
            alt=""
            loading={prioridade ? 'eager' : 'lazy'}
            fetchpriority={prioridade ? 'high' : undefined}
            decoding="async"
          />
        ) : (
          <span class="inicial" aria-hidden="true">
            {inicial}
          </span>
        )
      }
      {oferta.desconto !== undefined && <span class="desconto numeros">−{oferta.desconto}%</span>}
    </div>

    <h3>{oferta.titulo}</h3>

    <p class="precos">
      {
        oferta.precoDe !== undefined && (
          <span class="de numeros">
            <span class="sr">Preço cheio:</span>
            {formatarPreco(oferta.precoDe)}
          </span>
        )
      }
      <strong class="por numeros">{formatarPreco(oferta.preco)}</strong>
      {oferta.condicaoPreco && <span class="condicao">{oferta.condicaoPreco}</span>}
    </p>

    {
      oferta.precoAlternativo && (
        <p class="extra numeros">
          ou {formatarPreco(oferta.precoAlternativo.valor)} {oferta.precoAlternativo.rotulo}
        </p>
      )
    }

    {
      oferta.parcelas && (
        <p class="extra numeros">
          ou {oferta.parcelas.vezes}× de {formatarPreco(oferta.parcelas.valor)}
          {oferta.parcelas.semJuros ? ' sem juros' : ''}
        </p>
      )
    }

    {
      (selos.length > 0 || oferta.avaliacao !== undefined) && (
        <ul class="fatos">
          {oferta.avaliacao !== undefined && (
            <li>
              <svg class="estrela" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                <path
                  d="M10 1.6l2.47 5.26 5.53.82-4 4.06.95 5.76L10 14.8l-4.95 2.7.95-5.76-4-4.06 5.53-.82z"
                  fill="currentColor"
                />
              </svg>
              <span class="numeros">
                {oferta.avaliacao.toLocaleString('pt-BR', { minimumFractionDigits: 1 })}
                {oferta.avaliacoes !== undefined && ` (${oferta.avaliacoes})`}
              </span>
            </li>
          )}
          {selos.map((s) => <li class="selo">{s}</li>)}
        </ul>
      )
    }

    <!-- O botão é o único link da caixa, esticado sobre ela toda: um toque em
         qualquer lugar leva ao anúncio, e o leitor de tela ouve um destino só. -->
    <a class="cta" href={oferta.href} rel="sponsored nofollow noopener">
      Pegar oferta
      <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
        <path
          d="M4 10h11M11 5l5 5-5 5"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </a>

    {oferta.conferidoEm && <p class="nota">Conferido em {diaMes(oferta.conferidoEm)}</p>}
  </div>
</article>

<style>
  .caixa {
    /* profundidade da caixa: quanto o topo e a lateral aparecem */
    --d: 0.625rem;
    position: relative;
    padding: var(--d) var(--d) 0 0;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    /* O único movimento da página: as caixas assentam na prateleira ao abrir.
       O estado padrão (sem animação) já é totalmente visível. */
    animation: assenta 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(var(--i) * 80ms);
  }

  @keyframes assenta {
    from {
      transform: translateY(-0.75rem);
      opacity: 0;
    }
  }

  /* Topo da caixa, com a fita. A face é um retângulo inclinado em 45°. */
  .caixa::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: calc(100% - var(--d));
    height: var(--d);
    background:
      linear-gradient(90deg, transparent 36%, var(--fita) 36% 64%, transparent 64%),
      var(--caixa-topo);
    transform-origin: bottom left;
    transform: skewX(-45deg);
  }

  /* Lateral da caixa: a face na sombra. */
  .caixa::after {
    content: '';
    position: absolute;
    top: var(--d);
    right: 0;
    width: var(--d);
    height: calc(100% - var(--d));
    background: var(--caixa-lado);
    transform-origin: top left;
    transform: skewY(-45deg);
  }

  .caixa:hover {
    transform: translateY(-3px);
  }

  .caixa:active {
    transform: translateY(0) scale(0.99);
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .frente {
    display: flex;
    flex-direction: column;
    gap: var(--e-1);
    padding: 0.5rem 0.625rem 0.625rem;
    background: var(--caixa-frente);
  }

  /* Foto de anúncio tem fundo branco e o produto costuma ser escuro. Sobre a
     caixa escura ele sumiria, então a foto fica num tom claro e o branco dela
     se funde com ele (multiply). */
  .foto {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    margin-bottom: var(--e-1);
    overflow: hidden;
    background: var(--foto-fundo);
  }

    /* A imagem preenche o contêiner e o object-fit cuida da proporção. Com
     max-height: 100% a foto vazava e era cortada: porcentagem de altura não
     resolve dentro de um contêiner dimensionado só por aspect-ratio. */
  .foto img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: var(--e-2);
    mix-blend-mode: multiply;
  }

  .inicial {
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: 2.25rem;
    color: var(--foto-tinta);
  }

  .desconto {
    position: absolute;
    top: var(--e-1);
    left: var(--e-1);
    padding: 0.1rem 0.4rem;
    border-radius: 999px;
    background: var(--cta);
    color: var(--cta-texto);
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1.4;
  }

  /* Satoshi, não Clash Display: a Clash é fonte de título grande e em 15px as
     letras se fecham ("com" vira "oom"). Nome de produto precisa ler rápido. */
  h3 {
    margin: 0;
    font-family: var(--fonte-corpo);
    font-weight: 700;
    font-size: 0.9375rem;
    line-height: 1.25;
    color: var(--texto);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .precos {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--e-2);
    margin: var(--e-1) 0 0;
  }

  .de {
    font-size: 0.75rem;
    color: var(--texto-tenue);
    text-decoration: line-through;
  }

  .por {
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: 1.375rem;
    line-height: 1.1;
    letter-spacing: -0.015em;
    word-spacing: 0.12em;
    color: var(--texto);
  }

  /* "no Pix": a condição do preço, colada nele e legível. */
  .condicao {
    align-self: center;
    padding: 0.05rem 0.45rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--marca) 16%, transparent);
    color: var(--marca);
    font-size: 0.6875rem;
    font-weight: 700;
  }

  .extra {
    margin: 0;
    font-size: 0.75rem;
    color: var(--texto-suave);
  }

  .fatos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-1);
    margin: var(--e-1) 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.6875rem;
    color: var(--texto-suave);
  }

  .fatos li {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
  }

  .fatos .selo {
    padding: 0.05rem 0.45rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--marca) 14%, transparent);
    color: var(--marca);
    font-weight: 600;
  }

  .estrela {
    width: 0.8125rem;
    height: 0.8125rem;
    color: var(--marca);
  }

  .cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--e-1);
    min-height: 2.875rem; /* alvo de toque */
    margin-top: var(--e-2);
    padding: 0.55rem 0.5rem;
    white-space: nowrap;
    border-radius: 999px;
    background: var(--cta);
    color: var(--cta-texto);
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.15s;
  }

  /* Estica o link sobre a caixa inteira (o ancestral posicionado é .caixa). */
  .cta::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .cta:hover {
    background: var(--cta-hover);
  }

  .cta svg {
    flex: 0 0 auto;
    width: 0.95em;
    height: 0.95em;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .caixa:hover .cta svg {
    transform: translateX(3px);
  }

  .nota {
    margin: 0;
    text-align: center;
    font-size: 0.6875rem;
    line-height: 1.4;
    color: var(--texto-tenue);
  }

  /* Celular estreito (320px): a caixa fica com ~110px de frente. Menos recheio
     e sem a seta, pra o texto do botão caber. */
  @media (max-width: 22.5rem) {
    .caixa {
      --d: 0.5rem;
    }
    .frente {
      padding: 0.5rem;
    }
    .por {
      font-size: 1.25rem;
    }
    .cta svg {
      display: none;
    }
    /* Sem espaço: o botão de compra vale mais que as linhas secundárias. */
    .extra,
    .fatos {
      display: none;
    }
    h3 {
      -webkit-line-clamp: 4;
      line-clamp: 4;
    }
  }
</style>
