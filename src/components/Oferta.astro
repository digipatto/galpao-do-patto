---
import type { Oferta } from '../lib/ofertas';
import { formatarPreco } from '../lib/ofertas';

interface Props {
  oferta: Oferta;
  /** A primeira oferta está na primeira tela: carrega já, sem lazy. */
  prioridade?: boolean;
}

const { oferta, prioridade = false } = Astro.props;

// "2026-10-24" -> "24/10". Quebra a string em vez de usar Date: new Date() de
// uma data sem horário vira meia-noite UTC e, no fuso do Brasil, cai no dia
// anterior.
const diaMes = (iso: string) => {
  const [, mes, dia] = iso.split('-');
  return `${dia}/${mes}`;
};

const inicial = oferta.titulo.trim().charAt(0).toUpperCase();

const selos = [
  oferta.ranking,
  oferta.full && 'Full',
  oferta.lojaOficial && 'Loja oficial',
  oferta.freteGratis && 'Frete grátis',
].filter(Boolean) as string[];

const nota = [
  'Link de afiliado',
  oferta.conferidoEm && `preço conferido em ${diaMes(oferta.conferidoEm)}`,
]
  .filter(Boolean)
  .join(' · ');
---

<article class="oferta">
  <div class="foto">
    {
      oferta.img ? (
        <img
          src={oferta.img}
          alt=""
          loading={prioridade ? 'eager' : 'lazy'}
          fetchpriority={prioridade ? 'high' : undefined}
          decoding="async"
        />
      ) : (
        <span class="inicial" aria-hidden="true">
          {inicial}
        </span>
      )
    }
    {oferta.desconto !== undefined && <span class="desconto numeros">−{oferta.desconto}%</span>}
  </div>

  <div class="info">
    <h3>{oferta.titulo}</h3>

    <p class="precos">
      {
        oferta.precoDe !== undefined && (
          <span class="de numeros">
            <span class="sr">Preço cheio:</span>
            {formatarPreco(oferta.precoDe)}
          </span>
        )
      }
      <strong class="por numeros">{formatarPreco(oferta.preco)}</strong>
      {oferta.condicaoPreco && <span class="condicao">{oferta.condicaoPreco}</span>}
    </p>

    {
      oferta.precoAlternativo && (
        <p class="extra numeros">
          ou {formatarPreco(oferta.precoAlternativo.valor)} {oferta.precoAlternativo.rotulo}
        </p>
      )
    }

    {
      oferta.parcelas && (
        <p class="extra numeros">
          ou {oferta.parcelas.vezes}× de {formatarPreco(oferta.parcelas.valor)}
          {oferta.parcelas.semJuros ? ' sem juros' : ''}
        </p>
      )
    }

    {
      (selos.length > 0 || oferta.avaliacao !== undefined) && (
        <ul class="fatos">
          {oferta.avaliacao !== undefined && (
            <li>
              <svg class="estrela" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                <path
                  d="M10 1.6l2.47 5.26 5.53.82-4 4.06.95 5.76L10 14.8l-4.95 2.7.95-5.76-4-4.06 5.53-.82z"
                  fill="currentColor"
                />
              </svg>
              <span class="numeros">
                {oferta.avaliacao.toLocaleString('pt-BR', { minimumFractionDigits: 1 })}
                {oferta.avaliacoes !== undefined && ` (${oferta.avaliacoes})`}
              </span>
            </li>
          )}
          {selos.map((s) => <li class="selo">{s}</li>)}
        </ul>
      )
    }
  </div>

  <!-- O botão é o único link do card, esticado sobre ele todo: um toque em
       qualquer lugar leva ao anúncio, e o leitor de tela ouve um destino só. -->
  <a class="cta" href={oferta.href} rel="sponsored nofollow noopener">
    Pegar no Mercado Livre
    <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
      <path
        d="M4 10h11M11 5l5 5-5 5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </a>

  <p class="nota">{nota}</p>
</article>

<style>
  /* Linha compacta: miniatura, nome e preço lado a lado, botão embaixo. Pensada
     pra caber 2 ou 3 ofertas inteiras na primeira tela do celular. */
  .oferta {
    position: relative;
    display: grid;
    grid-template-columns: 6.25rem 1fr;
    gap: var(--e-3) var(--e-4);
    padding: var(--e-4);
    background: var(--fundo-elevado);
    border-radius: var(--raio);
    box-shadow: var(--sombra);
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Foto de anúncio tem fundo branco e o produto costuma ser escuro. Sobre o
     card escuro ele sumiria, então a foto fica num tom claro e o branco dela se
     funde com ele (multiply). */
  .foto {
    position: relative;
    display: grid;
    place-items: center;
    align-self: start;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--foto-fundo);
    border-radius: var(--raio-sm);
  }

  .foto img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    padding: var(--e-2);
    mix-blend-mode: multiply;
  }

  .inicial {
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: 2.25rem;
    color: var(--foto-tinta);
  }

  .desconto {
    position: absolute;
    top: var(--e-1);
    left: var(--e-1);
    padding: 0.1rem 0.4rem;
    border-radius: 999px;
    background: var(--cta);
    color: var(--cta-texto);
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: var(--e-1);
    min-width: 0;
  }

  /* Satoshi, não Clash Display: a Clash é fonte de título grande e em 16px as
     letras se fecham ("com" vira "oom"). Nome de produto precisa ler rápido. */
  h3 {
    margin: 0;
    font-family: var(--fonte-corpo);
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.25;
    color: var(--texto);
    /* Título longo não empurra o preço pra fora da primeira tela. */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .precos {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--e-2);
    margin: 0;
  }

  .de {
    font-size: 0.8125rem;
    color: var(--texto-tenue);
    text-decoration: line-through;
  }

  .por {
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: 1.625rem;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--texto);
  }

  /* "no Pix": a condição do preço, colada nele e legível. */
  .condicao {
    align-self: center;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--marca) 16%, transparent);
    color: var(--marca);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .extra {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--texto-suave);
  }

  .fatos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-1) var(--e-2);
    margin: var(--e-1) 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.75rem;
    color: var(--texto-suave);
  }

  .fatos li {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .fatos .selo {
    padding: 0.05rem 0.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--marca) 14%, transparent);
    color: var(--marca);
    font-weight: 600;
  }

  .estrela {
    width: 0.875rem;
    height: 0.875rem;
    color: var(--marca);
  }

  .cta {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--e-2);
    min-height: 3rem; /* alvo de toque */
    padding: 0.7rem 1.25rem;
    border-radius: 999px;
    background: var(--cta);
    color: var(--cta-texto);
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.15s, transform 0.15s;
  }

  .cta::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .cta:hover {
    background: var(--cta-hover);
  }

  .cta:active {
    transform: scale(0.99);
  }

  .cta svg {
    width: 1.1em;
    height: 1.1em;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cta:hover svg {
    transform: translateX(3px);
  }

  .nota {
    grid-column: 1 / -1;
    margin: calc(var(--e-1) * -1) 0 0;
    text-align: center;
    font-size: 0.6875rem;
    line-height: 1.4;
    color: var(--texto-tenue);
  }
</style>
