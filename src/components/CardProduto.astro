---
import type { Oferta } from '../lib/ofertas';
import { formatarPreco } from '../lib/ofertas';
import { ROTULO_NICHO } from '../lib/schema';

interface Props {
  oferta: Oferta;
}

const { oferta } = Astro.props;

// Sem foto o card não pode virar um buraco: usa a cor do nicho e a inicial.
// Isso é o estado normal enquanto a foto não foi colada, não um erro.
const corNicho = `var(--nicho-${oferta.nicho})`;
const inicial = oferta.titulo.trim().charAt(0).toUpperCase();
---

<article class="card" style={`--cor-nicho: ${corNicho}`}>
  <a class="alvo" href={oferta.href} rel="sponsored nofollow noopener">
    <span class="sr">Pegar oferta: {oferta.titulo}</span>
  </a>

  <div class="foto">
    {
      oferta.img ? (
        <img src={oferta.img} alt="" loading="lazy" decoding="async" width="400" height="400" />
      ) : (
        <span class="inicial" aria-hidden="true">{inicial}</span>
      )
    }

    {oferta.desconto !== undefined && <span class="desconto">-{oferta.desconto}%</span>}
    {oferta.full && <span class="full">Full</span>}
  </div>

  <div class="corpo">
    <span class="nicho">{ROTULO_NICHO[oferta.nicho]}</span>
    <h3 class="titulo">{oferta.titulo}</h3>

    <p class="precos">
      {
        oferta.precoDe !== undefined && (
          <span class="de">{formatarPreco(oferta.precoDe)}</span>
        )
      }
      <strong class="por">{formatarPreco(oferta.preco)}</strong>
    </p>

    {oferta.loja && <p class="loja">em {oferta.loja}</p>}

    <span class="cta" aria-hidden="true">Pegar oferta</span>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--superficie);
    border: 1px solid var(--superficie-borda);
    border-radius: var(--raio);
    overflow: hidden;
    transition: border-color 0.15s, transform 0.15s;
  }

  .card:hover,
  .card:focus-within {
    border-color: color-mix(in srgb, var(--cor-nicho) 55%, var(--superficie-borda));
    transform: translateY(-2px);
  }

  /* O card inteiro é clicável, mas o link é um só — leitor de tela ouve um
     destino, não três. */
  .alvo {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .foto {
    position: relative;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    background: linear-gradient(
      150deg,
      color-mix(in srgb, var(--cor-nicho) 22%, var(--fundo-elevado)),
      var(--fundo-elevado)
    );
  }

  .foto img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 0.75rem;
  }

  .inicial {
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: 2.75rem;
    color: color-mix(in srgb, var(--cor-nicho) 70%, var(--texto));
    opacity: 0.55;
  }

  .desconto,
  .full {
    position: absolute;
    top: 0.5rem;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.5;
  }

  .desconto {
    left: 0.5rem;
    background: var(--cta);
    color: var(--cta-texto);
  }

  .full {
    right: 0.5rem;
    background: var(--acento);
    color: var(--p-grafite-900);
  }

  .corpo {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.75rem 0.875rem 0.875rem;
    flex: 1;
  }

  .nicho {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--cor-nicho);
  }

  .titulo {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--texto);
    /* Título longo não pode empurrar o preço pra fora do card. */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .precos {
    margin: 0.2rem 0 0;
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .de {
    font-size: 0.8125rem;
    color: var(--texto-tenue);
    text-decoration: line-through;
  }

  .por {
    font-size: 1.1875rem;
    font-weight: 700;
    color: var(--texto);
    letter-spacing: -0.01em;
  }

  .loja {
    margin: 0;
    font-size: 0.75rem;
    color: var(--texto-tenue);
  }

  .cta {
    margin-top: auto;
    padding-top: 0.7rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--acento);
  }

  .card:hover .cta {
    color: var(--acento-quente);
  }
</style>
